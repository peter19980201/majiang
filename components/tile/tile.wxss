:host {
  display:inline-block;
  vertical-align:middle;
  line-height:0;
}

.tile {
  position:relative;
  display:inline-flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  box-sizing:border-box;
  background:linear-gradient(125deg,#fffef9 0%,#fbf6e7 60%,#ece5d0 100%);
  border:1rpx solid #c9bfa0;
  border-radius:8rpx;
  box-shadow:inset 0 0 0 2rpx #fffdf5,inset -3rpx -4rpx 6rpx rgba(105,93,53,.10),0 3rpx 0 #aaa98b,0 5rpx 5rpx rgba(31,41,20,.12);
  overflow:hidden;
  font-family:'Songti SC','STSong',serif;
  color:#153c2d;
}

.normal {
  width:78rpx;
  height:100rpx;
  font-size:36rpx;
}

.small {
  width:46rpx;
  height:62rpx;
  font-size:23rpx;
  border-radius:5rpx;
}

.mini {
  width:38rpx;
  height:50rpx;
  font-size:19rpx;
  border-radius:4rpx;
}

.picker {
  width:64rpx;
  height:86rpx;
  font-size:30rpx;
}

.large {
  width:84rpx;
  height:108rpx;
  font-size:39rpx;
}

.man-number {
  font-size:.8em;
  line-height:1.1;
  font-weight:800;
  color:#1f3326;
}

.man-suit {
  font-size:1em;
  line-height:1.1;
  font-weight:800;
  color:#a23327;
}

.honor-face {
  font-size:1.3em;
  line-height:1;
  font-weight:800;
}

.green {
  color:#2c6838;
}

.red {
  color:#a52d25;
}

.white-dragon {
  position:absolute;
  inset:14% 18%;
  border:2rpx solid #bccdc7;
  border-radius:4rpx;
}

.agari {
  border-color:#b69343;
  background:#fbf0d4;
  box-shadow:0 0 0 2rpx #b69343,0 4rpx 0 #b29b65;
}

.red5 {
  background:#faf2e8;
}

.red5-on {
  border-color:#ae4a38;
  box-shadow:0 0 0 3rpx #ae4a38,0 4rpx 0 #ba7a61;
}

.is-red .man-number,.is-red .man-suit {
  color:#b02e25;
}

.dark {
  background:linear-gradient(#dde3cd,#c1cdb0);
  border-color:#97aa8c;
}

.disabled {
  opacity:.28;
}

.clickable:active {
  background:#dce6cf;
  transform:translateY(2rpx);
}

.face-art { width:100%; height:100%; position:absolute; inset:0; pointer-events:none; }

/* Full-body artwork already contains its ivory surface and bevel. */
.tile.engraved {
  background:transparent;
  border-color:transparent;
  box-shadow:none;
  overflow:visible;
}
.body-art { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; }
.tile.engraved.agari { box-shadow:0 0 0 2rpx #b69343; }
.tile.engraved.red5-on { box-shadow:0 0 0 3rpx #ae4a38; }
.tile.engraved.dark .body-art { filter:brightness(.83) saturate(.7); }
.tile.engraved.clickable:active { background:transparent; opacity:.8; }
