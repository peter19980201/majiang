<image class="page-landscape" src="/assets/home/profile-landscape.jpg" mode="aspectFill" aria-hidden="true" />
<image class="page-motto-art" src="/assets/home/profile-motto.png" mode="aspectFit" aria-label="以牌会友，乐在其中" />
<view class="report-page">
  <view class="report-loading" wx:if="{{loading}}" role="status"><view class="report-spinner" aria-hidden="true"></view><text class="report-message">正在生成本场战报…</text></view>
  <view wx:if="{{error}}"><text class="report-message">{{error}}</text><button bindtap="generate">重新生成</button></view>
  <image wx:if="{{imagePath}}" class="poster {{posterReady ? 'poster-ready' : ''}}" bindload="onPosterLoad" binderror="onPosterError" src="{{imagePath}}" mode="widthFix" show-menu-by-longpress></image>
  <button class="save" bindtap="save" disabled="{{!imagePath || saving}}" loading="{{saving}}">保存战报图片</button>
  <text class="report-message">保存后可发送给微信好友或群聊</text>
  <canvas type="2d" id="reportCanvas" class="export-canvas"></canvas>
</view>

<confirmation-dialog id="confirmation-dialog" />
