page { background:#faf8ef; }
.report-page { padding:24rpx 26rpx calc(32rpx + env(safe-area-inset-bottom)); font-family:'Songti SC','STSong','SimSun',serif; }
.poster { display:block; width:100%; box-sizing:border-box; border:20rpx solid #eeede2; box-shadow:0 6rpx 22rpx rgba(47,60,35,.08); }
.save { width:100%!important; box-sizing:border-box; margin:24rpx 0 0!important; background:#163f33; color:#fffdf4; font-family:inherit; font-size:var(--font-label, 32rpx); line-height:1.5; padding:21rpx 0!important; border-radius:12rpx; }
.report-message { display:block; text-align:center; margin:20rpx 0 0; color:#858776; font-size:var(--font-small, 24rpx); }
.export-canvas { position:fixed; left:-2000px; top:0; width:750px; height:1160px; pointer-events:none; }

@import '/styles/felt.wxss';

.report-loading { display:flex; justify-content:center; align-items:center; gap:16rpx; }
.report-spinner { width:28rpx; height:28rpx; border:3rpx solid #d5d9c8; border-top-color:#285744; border-radius:50%; animation:report-spin 700ms linear infinite; }
.poster { opacity:0; transform:translateY(6rpx); transition:opacity 220ms ease-out,transform 220ms cubic-bezier(.23,1,.32,1); }
.poster.poster-ready { opacity:1; transform:translateY(0); }
@keyframes report-spin { to { transform:rotate(360deg); } }
@media (prefers-reduced-motion:reduce) { .report-spinner { animation:none; } .poster { transition:none; transform:none; } }
