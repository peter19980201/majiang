.container {
  padding:24rpx;
}

.search-bar {
  margin-bottom:22rpx;
}

.search-input-wrap {
  display:flex;
  align-items:center;
  gap:20rpx;
  background:#eeeee7;
  border:1rpx solid #e0e3d6;
  border-radius:100rpx;
  padding:0 26rpx;
  height:82rpx;
}

.search-icon {
  width:27rpx;
  height:27rpx;
  border:3rpx solid #647565;
  border-radius:50%;
  position:relative;
  flex-shrink:0;
}

.search-icon::after {
  content:'';
  position:absolute;
  width:14rpx;
  height:3rpx;
  background:#647565;
  right:-10rpx;
  bottom:-5rpx;
  transform:rotate(48deg);
}

.search-input {
  flex:1;
  min-width:0;
  height:82rpx;
  font-size:var(--font-body, 28rpx);
}

.search-clear {
  padding:10rpx;
  font-size:var(--font-label, 32rpx);
  color:#6e7d67;
}

.filter-row {
  margin-bottom:24rpx;
}

.cat-scroll {
  width:100%;
  white-space:nowrap;
}

.cat-tags {
  display:inline-flex;
  gap:12rpx;
  padding-bottom:6rpx;
}

.cat-tag {
  padding:15rpx 27rpx;
  border-radius:100rpx;
  background:#edeee5;
  font-size:var(--font-small, 24rpx);
  color:#506646;
  white-space:nowrap;
}

.cat-tag.active {
  background:#275743;
  color:#fff;
  font-weight:600;
}

.filter-footer {
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-top:18rpx;
}

.menzen-toggle {
  display:flex;
  align-items:center;
  gap:16rpx;
  padding:4rpx 0;
  font-size:var(--font-body, 28rpx);
  color:#55684b;
}

.switch-track {
  width:78rpx;
  height:44rpx;
  border-radius:100rpx;
  background:#c4c9ba;
  padding:5rpx;
}

.switch-knob {
  width:34rpx;
  height:34rpx;
  background:#fffef8;
  border-radius:50%;
  box-shadow:0 1rpx 5rpx rgba(32,50,20,.15);
  transition:transform .15s;
}

.switch-track.active {
  background:#2e5c40;
}

.switch-track.active .switch-knob {
  transform:translateX(34rpx);
}

.filter-count {
  font-size:var(--font-caption, 22rpx);
  color:#839077;
}

.yaku-card {
  margin-bottom:14rpx;
  background:#fdfcf8;
  border:1rpx solid #e7e8dd;
  border-radius:22rpx;
  overflow:hidden;
}

.yaku-header {
  position:relative;
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:25rpx 24rpx;
  gap:16rpx;
  min-height:132rpx;
}

.yaku-title-area {
  flex:1;
  min-width:0;
}

.yaku-name-cn {
  display:block;
  font-size:var(--font-label, 32rpx);
  font-weight:600;
  line-height:1.3;
}

.yaku-name-ja {
  display:block;
  color:#859079;
  font-size:var(--font-caption, 22rpx);
  margin-top:8rpx;
}

.yaku-badges {
  display:flex;
  flex-wrap:wrap;
  justify-content:flex-end;
  align-items:center;
  gap:8rpx;
  max-width:290rpx;
}

.badge {
  font-size:var(--font-caption, 22rpx);
  white-space:nowrap;
}

.badge.han {
  font-family:'Songti SC','STSong',serif;
  font-size:var(--font-heading, 36rpx);
  color:#a87c26;
  font-weight:700;
}

.badge.han.open {
  font-family:inherit;
  font-size:var(--font-caption, 22rpx);
  color:#6a7c5f;
  font-weight:400;
}

.badge.menzen {
  padding:5rpx 12rpx;
  background:#e4ede0;
  border-radius:10rpx;
  color:#426543;
}

.badge.yakuman {
  font-size:var(--font-body, 28rpx);
  color:#a27421;
  font-weight:700;
}

.badge.double {
  color:#a04931;
}

.yaku-chevron {
  font-size:var(--font-label, 32rpx);
  color:#728467;
  margin-left:5rpx;
}

.yaku-desc {
  display:block;
  padding:4rpx 24rpx 24rpx;
  color:#56694d;
  font-size:var(--font-body, 28rpx);
  line-height:1.65;
}

.yaku-detail {
  margin:0 24rpx;
  padding:22rpx 0;
  border-top:1rpx dashed #d9dfcd;
}

.detail-section+.detail-section {
  border-top:1rpx dashed #d9dfcd;
  margin-top:22rpx;
  padding-top:22rpx;
}

.detail-label {
  display:block;
  color:#506844;
  font-size:var(--font-small, 24rpx);
  margin-bottom:10rpx;
  font-weight:600;
}

.detail-text {
  display:block;
  font-size:var(--font-body, 28rpx);
  line-height:1.75;
  color:#4e6242;
}

.example-card { padding:24rpx 0; border-top:1rpx solid #d9d1bb; }
.example-heading { display:flex; align-items:baseline; justify-content:space-between; gap:16rpx; }
.example-title { color:#204e40; font-size:var(--font-body, 28rpx); font-weight:600; }
.example-count { flex-shrink:0; color:#78886a; font-size:var(--font-small, 24rpx); }
.example-context { display:flex; flex-wrap:wrap; gap:10rpx; margin:16rpx 0; }
.example-chip { padding:5rpx 12rpx; border-radius:8rpx; background:#edf0e7; color:#4e6242; font-size:var(--font-small, 24rpx); }
.example-win { display:block; color:#866623; font-size:var(--font-body, 28rpx); font-weight:600; margin-bottom:12rpx; }
.example-situation { display:block; color:#4e6242; font-size:var(--font-small, 24rpx); line-height:1.75; margin-bottom:20rpx; }
.example-section-label { display:block; color:#4e6242; font-size:var(--font-small, 24rpx); margin:12rpx 0; }
.example-groups { display:flex; flex-wrap:wrap; gap:16rpx 24rpx; align-items:flex-start; }
.example-group { flex-shrink:0; }
.example-group-label { display:block; color:#78886a; font-size:var(--font-caption, 22rpx); margin-bottom:10rpx; }
.example-group-tiles { display:flex; gap:4rpx; align-items:flex-start; }
.example-tile-cell { position:relative; padding-bottom:32rpx; }
.example-win-marker { position:absolute; bottom:0; left:0; right:0; text-align:center; color:#866623; font-size:var(--font-caption, 22rpx); line-height:30rpx; }
.example-meld-area { margin-top:14rpx; padding-top:10rpx; border-top:1rpx dashed #d9d1bb; }
.example-meld { padding-bottom:10rpx; }
.example-reason { margin-top:20rpx; padding:12rpx 18rpx; border-left:3rpx solid #b69343; background:rgba(182,147,67,.06); }
.example-note { display:block; color:#4e6242; font-size:var(--font-small, 24rpx); line-height:1.75; }

.rules-page { padding-bottom:calc(140rpx + env(safe-area-inset-bottom)); }
.rules-tabs { margin-bottom:24rpx; }
.rules-tabs .seg { flex:1; margin:0; background:transparent; line-height:1.5; }
.rules-tabs .seg.active { background:#204e40; }



/* 三栏均分，长标题仍在单行内；只覆盖规则页的滑动底板。 */
.rules-tabs.motion-segments > .motion-selection { width:calc((100% - 8rpx) / 3); }
.rules-tabs .seg { min-width:0; padding:16rpx 0; font-size:var(--font-small, 24rpx); white-space:nowrap; }
.special-section { margin:28rpx 0 36rpx; }
.special-section-title { display:block; color:#204e40; font-size:var(--font-label, 32rpx); font-weight:600; }
.special-intro { display:block; color:#78886a; font-size:var(--font-small, 24rpx); line-height:1.7; margin:10rpx 0 20rpx; }
.special-summary { display:block; color:#78886a; font-size:var(--font-small, 24rpx); line-height:1.6; margin-top:8rpx; }
.special-badges { flex-shrink:0; display:flex; flex-direction:column; gap:12rpx; align-items:flex-end; }
.special-paragraph { display:block; color:#4e6242; font-size:var(--font-small, 24rpx); line-height:1.8; margin:10rpx 0; }
.special-illustrations { display:flex; flex-wrap:wrap; gap:18rpx 32rpx; }
.special-river { display:grid; grid-template-columns:repeat(6, 64rpx); gap:10rpx 4rpx; margin:16rpx 0; }
.special-rows { margin:22rpx 0; }
.special-row { padding:14rpx 0; border-bottom:1rpx solid #e1dccb; }
.special-row-label { color:#204e40; font-size:var(--font-small, 24rpx); font-weight:600; }


@import '/styles/felt.wxss';
