.container {
  padding:24rpx;
}

.search-bar {
  margin-bottom:22rpx;
}

.search-input-wrap {
  display:flex;
  align-items:center;
  gap:20rpx;
  background:#eeeee7;
  border:1rpx solid #e0e3d6;
  border-radius:100rpx;
  padding:0 26rpx;
  height:82rpx;
}

.search-icon {
  width:27rpx;
  height:27rpx;
  border:3rpx solid #647565;
  border-radius:50%;
  position:relative;
  flex-shrink:0;
}

.search-icon::after {
  content:'';
  position:absolute;
  width:14rpx;
  height:3rpx;
  background:#647565;
  right:-10rpx;
  bottom:-5rpx;
  transform:rotate(48deg);
}

.search-input {
  flex:1;
  min-width:0;
  height:82rpx;
  font-size:var(--font-body, 28rpx);
}

.search-clear {
  padding:10rpx;
  font-size:var(--font-label, 32rpx);
  color:#6e7d67;
}

.filter-row {
  margin-bottom:24rpx;
}

.cat-scroll {
  width:100%;
  white-space:nowrap;
}

.cat-tags {
  display:inline-flex;
  gap:12rpx;
  padding-bottom:6rpx;
}

.cat-tag {
  padding:15rpx 27rpx;
  border-radius:100rpx;
  background:#edeee5;
  font-size:var(--font-small, 24rpx);
  color:#506646;
  white-space:nowrap;
}

.cat-tag.active {
  background:#275743;
  color:#fff;
  font-weight:600;
}

.filter-footer {
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-top:18rpx;
}

.menzen-toggle {
  display:flex;
  align-items:center;
  gap:16rpx;
  padding:4rpx 0;
  font-size:var(--font-body, 28rpx);
  color:#55684b;
}

.switch-track {
  width:78rpx;
  height:44rpx;
  border-radius:100rpx;
  background:#c4c9ba;
  padding:5rpx;
}

.switch-knob {
  width:34rpx;
  height:34rpx;
  background:#fffef8;
  border-radius:50%;
  box-shadow:0 1rpx 5rpx rgba(32,50,20,.15);
  transition:transform .15s;
}

.switch-track.active {
  background:#2e5c40;
}

.switch-track.active .switch-knob {
  transform:translateX(34rpx);
}

.filter-count {
  font-size:var(--font-caption, 22rpx);
  color:#839077;
}

.yaku-card {
  margin-bottom:14rpx;
  background:#fdfcf8;
  border:1rpx solid #e7e8dd;
  border-radius:22rpx;
  overflow:hidden;
}

.yaku-header {
  position:relative;
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:25rpx 24rpx;
  gap:16rpx;
  min-height:132rpx;
}

.yaku-title-area {
  flex:1;
  min-width:0;
}

.yaku-name-cn {
  display:block;
  font-size:var(--font-label, 32rpx);
  font-weight:600;
  line-height:1.3;
}

.yaku-name-ja {
  display:block;
  color:#859079;
  font-size:var(--font-caption, 22rpx);
  margin-top:8rpx;
}

.yaku-badges {
  display:flex;
  flex-wrap:wrap;
  justify-content:flex-end;
  align-items:center;
  gap:8rpx;
  max-width:290rpx;
}

.badge {
  font-size:var(--font-caption, 22rpx);
  white-space:nowrap;
}

.badge.han {
  font-family:'Songti SC','STSong',serif;
  font-size:var(--font-heading, 36rpx);
  color:#a87c26;
  font-weight:700;
}

.badge.han.open {
  font-family:inherit;
  font-size:var(--font-caption, 22rpx);
  color:#6a7c5f;
  font-weight:400;
}

.badge.menzen {
  padding:5rpx 12rpx;
  background:#e4ede0;
  border-radius:10rpx;
  color:#426543;
}

.badge.yakuman {
  font-size:var(--font-body, 28rpx);
  color:#a27421;
  font-weight:700;
}

.badge.double {
  color:#a04931;
}

.yaku-chevron {
  font-size:var(--font-label, 32rpx);
  color:#728467;
  margin-left:5rpx;
}

.yaku-desc {
  display:block;
  padding:4rpx 24rpx 24rpx;
  color:#56694d;
  font-size:var(--font-body, 28rpx);
  line-height:1.65;
}

.yaku-detail {
  margin:0 24rpx;
  padding:22rpx 0;
  border-top:1rpx dashed #d9dfcd;
}

.detail-section+.detail-section {
  border-top:1rpx dashed #d9dfcd;
  margin-top:22rpx;
  padding-top:22rpx;
}

.detail-label {
  display:block;
  color:#506844;
  font-size:var(--font-small, 24rpx);
  margin-bottom:10rpx;
  font-weight:600;
}

.detail-text {
  display:block;
  font-size:var(--font-body, 28rpx);
  line-height:1.75;
  color:#4e6242;
}

.example-hand {
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:10rpx;
  margin-top:18rpx;
}

.example-tiles {
  display:flex;
  flex-wrap:wrap;
  gap:8rpx;
}

.example-agari {
  margin-left:5rpx;
}

.example-note {
  display:block;
  font-size:var(--font-small, 24rpx);
  line-height:1.6;
  color:#78886a;
  margin-top:16rpx;
}


.example-pairs { display:flex; flex-wrap:wrap; gap:20rpx 18rpx; margin-top:18rpx; }
.example-pair { display:flex; gap:4rpx; padding-bottom:9rpx; border-bottom:1rpx solid #c3baa1; }

.rules-page { padding-bottom:calc(140rpx + env(safe-area-inset-bottom)); }
.rules-tabs { margin-bottom:24rpx; }
.rules-tabs .seg { flex:1; margin:0; background:transparent; line-height:1.5; }
.rules-tabs .seg.active { background:#204e40; }

@import '/styles/felt.wxss';
