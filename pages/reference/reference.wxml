<image class="page-landscape page-landscape-tab" src="/assets/home/profile-landscape.jpg" mode="aspectFill" aria-hidden="true" />
<image class="page-motto-art" src="/assets/home/profile-motto.png" mode="aspectFit" aria-label="以牌会友，乐在其中" />
<view class="container rules-page">
  <view class="seg-ctrl rules-tabs motion-segments"><view class="motion-selection" aria-hidden="true" style="transform:translateX({{rulesTab === 'yaku' ? 0 : rulesTab === 'points' ? 100 : 200}}%)"></view><button class="seg {{rulesTab === 'yaku' ? 'active' : ''}}" bindtap="selectRulesTab" data-tab="yaku">役种速查</button><button class="seg {{rulesTab === 'points' ? 'active' : ''}}" bindtap="selectRulesTab" data-tab="points">点数速查</button><button class="seg {{rulesTab === 'special' ? 'active' : ''}}" bindtap="selectRulesTab" data-tab="special">宝牌及流局</button></view>
  <view hidden="{{rulesTab !== 'yaku'}}">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <view class="search-icon"></view>
      <input class="search-input" placeholder="搜索役种名称或说明"
             value="{{keyword}}" bindinput="onKeywordInput" />
      <text class="search-clear" wx:if="{{keyword}}" bindtap="onClearKeyword">×</text>
    </view>
  </view>

  <!-- 筛选标签 -->
  <view class="filter-row">
    <scroll-view enhanced="{{true}}" show-scrollbar="{{false}}" scroll-x class="cat-scroll">
      <view class="cat-tags">
        <text class="cat-tag {{activeCategory === '' ? 'active' : ''}}"
              bindtap="onCategoryTap" data-cat="">全部</text>
        <text class="cat-tag {{activeCategory === item ? 'active' : ''}}"
              wx:for="{{categories}}" wx:key="*this"
              bindtap="onCategoryTap" data-cat="{{item}}">{{item}}</text>
      </view>
    </scroll-view>
    <view class="filter-footer"><view class="menzen-toggle" bindtap="onToggleMenzen"><view class="switch-track {{filterMenzen ? 'active' : ''}}"><view class="switch-knob"></view></view><text>门前限定</text></view><text class="filter-count">{{filteredYaku.length}} 项役种</text></view>
  </view>

  <!-- 役种列表 -->
  <view class="yaku-list">
    <view class="yaku-card {{expandedIndex === index ? 'expanded' : ''}}"
          wx:for="{{filteredYaku}}" wx:key="_index">
      <!-- 头部 -->
      <view class="yaku-header" bindtap="onExpandTap" data-idx="{{index}}">
        <view class="yaku-title-area">
          <text class="yaku-name-cn">{{item.name}}</text>
          <text class="yaku-name-ja">{{item.nameJa}}</text>
        </view>
        <view class="yaku-badges">
          <text class="badge menzen" wx:if="{{item.menzenOnly}}">门前限定</text>
          <text class="badge han" wx:if="{{!item.isYakuman}}">{{item.han}}番</text>
          <text class="badge han open" wx:if="{{!item.isYakuman && item.hanOpen !== null && item.hanOpen !== item.han}}">副露{{item.hanOpen}}番</text>
          <text class="badge yakuman" wx:if="{{item.isYakuman && item.yakumanTimes === 1}}">役满</text>
          <text class="badge yakuman double" wx:if="{{item.isYakuman && item.yakumanTimes === 2}}">双倍役满</text><text class="yaku-chevron motion-chevron {{expandedIndex === index ? 'motion-open' : ''}}">›</text>
        </view>
      </view>
      <!-- 简述 -->
      <view class="motion-collapse {{expandedIndex === index ? 'motion-open' : ''}}" aria-hidden="{{expandedIndex !== index}}"><view class="motion-collapse-inner"><view wx:if="{{expandedYaku[item._index]}}">
      <text class="yaku-desc">{{item.desc}}</text>
      <!-- 展开详情 -->
      <view class="yaku-detail">
        <view class="detail-section">
          <text class="detail-label">成立条件</text>
          <text class="detail-text">{{item.condition}}</text>
        </view>
        <view class="detail-section examples-section">
          <text class="detail-label">示例牌型</text>
          <view class="example-card" wx:for="{{item._examples}}" wx:for-item="example" wx:key="title">
            <view class="example-heading"><text class="example-title">{{example.title}}</text><text class="example-count">{{example.count}}张</text></view>
            <view class="example-context"><text class="example-chip" wx:for="{{example.state}}" wx:for-item="state" wx:key="*this">{{state}}</text></view>
            <text class="example-win">{{example.winLabel}}</text>
            <text class="example-situation" wx:if="{{example.situation}}">{{example.situation}}</text>
            <text class="example-section-label">手牌（含和了牌）</text>
            <view class="example-groups">
              <view class="example-group" wx:for="{{example.groups}}" wx:for-item="group" wx:key="index">
                <text class="example-group-label">{{group.label}}</text>
                <view class="example-group-tiles">
                  <view class="example-tile-cell" wx:for="{{group.tiles}}" wx:for-item="tileData" wx:key="index">
                    <tile tid="{{tileData.tid}}" size="picker" extra="{{tileData.winning ? 'agari' : ''}}"></tile>
                    <text class="example-win-marker" wx:if="{{tileData.winning}}">和</text>
                  </view>
                </view>
              </view>
            </view>
            <view class="example-meld-area" wx:if="{{example.melds.length}}">
              <text class="example-section-label">副露 / 杠组（暗杠不破门前）</text>
              <view class="example-groups">
                <view class="example-group example-meld" wx:for="{{example.melds}}" wx:for-item="meld" wx:key="index">
                  <text class="example-group-label">{{meld.label}}</text>
                  <view class="example-group-tiles"><tile wx:for="{{meld.tiles}}" wx:for-item="meldTile" wx:key="index" tid="{{meldTile}}" size="picker"></tile></view>
                </view>
              </view>
            </view>
            <view class="example-reason"><text class="example-section-label">本例为何成立</text><text class="example-note">{{example.note}}</text></view>
          </view>
        </view>
      </view>
      </view></view></view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{filteredYaku.length === 0}}">
    <text class="empty-symbol">役</text><text class="empty-text">没有找到匹配的役种</text><text class="empty-hint">试试其他名称，或调整筛选条件</text>
  </view>
  </view>
  <view hidden="{{rulesTab !== 'points'}}"><points-table /></view>
  <view hidden="{{rulesTab !== 'special'}}" class="special-reference">
    <view class="special-section" wx:for="{{specialSections}}" wx:for-item="section" wx:key="title">
      <text class="special-section-title">{{section.title}}</text>
      <text class="special-intro">{{section.intro}}</text>
      <view class="yaku-card" wx:for="{{section.cards}}" wx:for-item="card" wx:key="id">
        <view class="yaku-header" bindtap="onSpecialTap" data-id="{{card.id}}" role="button" aria-expanded="{{expandedSpecial === card.id}}">
          <view class="yaku-title-area"><text class="yaku-name-cn">{{card.title}}</text><text class="special-summary">{{card.summary}}</text></view>
          <view class="special-badges"><text class="badge">{{card.badge}}</text><text class="yaku-chevron motion-chevron {{expandedSpecial === card.id ? 'motion-open' : ''}}">›</text></view>
        </view>
        <view class="motion-collapse {{expandedSpecial === card.id ? 'motion-open' : ''}}" aria-hidden="{{expandedSpecial !== card.id}}"><view class="motion-collapse-inner"><view class="yaku-detail" wx:if="{{visitedSpecial[card.id]}}">
          <view class="detail-section"><text class="detail-label">{{section.title === '宝牌说明' ? '加番条件' : '规则说明'}}</text><text class="special-paragraph" wx:for="{{card.rules}}" wx:for-item="rule" wx:key="*this">{{rule}}</text></view>
          <view class="special-illustrations" wx:if="{{card.illustrations}}">
            <view wx:for="{{card.illustrations}}" wx:for-item="illustration" wx:key="label"><text class="example-section-label">{{illustration.label}}</text><view class="example-group-tiles"><tile wx:for="{{illustration.tiles}}" wx:for-item="tileData" wx:key="index" tid="{{tileData.tid}}" extra="{{tileData.extra}}" size="picker" /></view></view>
          </view>
          <view wx:if="{{card.river}}"><text class="example-section-label">成立示例 · 舍牌河（按舍牌顺序）</text><view class="special-river"><tile wx:for="{{card.river}}" wx:for-item="riverTile" wx:key="index" tid="{{riverTile.tid}}" size="picker" /></view></view>
          <view class="example-reason"><text class="example-section-label">{{card.id === 'nagashi' ? '本例为何成立' : '实例'}}</text><text class="example-note">{{card.example}}</text></view>
          <view class="special-rows" wx:if="{{card.rows}}"><view class="special-row" wx:for="{{card.rows}}" wx:for-item="row" wx:key="label"><text class="special-row-label">{{row.label}}</text><text class="special-paragraph">{{row.value}}</text></view></view>
          <view class="detail-section" wx:if="{{card.id !== 'abortive'}}"><text class="detail-label">{{section.title === '宝牌说明' ? '补充说明' : '本工具处理方式'}}</text><text class="special-paragraph" wx:for="{{card.notes}}" wx:for-item="note" wx:key="*this">{{note}}</text></view>
        </view></view></view>
      </view>
    </view>
  </view>
</view>
