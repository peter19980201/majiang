<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <view class="search-icon"></view>
      <input class="search-input" placeholder="搜索役种名称或说明"
             value="{{keyword}}" bindinput="onKeywordInput" />
      <text class="search-clear" wx:if="{{keyword}}" bindtap="onClearKeyword">×</text>
    </view>
  </view>

  <!-- 筛选标签 -->
  <view class="filter-row">
    <scroll-view scroll-x class="cat-scroll">
      <view class="cat-tags">
        <text class="cat-tag {{activeCategory === '' ? 'active' : ''}}"
              bindtap="onCategoryTap" data-cat="">全部</text>
        <text class="cat-tag {{activeCategory === item ? 'active' : ''}}"
              wx:for="{{categories}}" wx:key="*this"
              bindtap="onCategoryTap" data-cat="{{item}}">{{item}}</text>
      </view>
    </scroll-view>
    <view class="filter-footer"><view class="menzen-toggle" bindtap="onToggleMenzen"><view class="switch-track {{filterMenzen ? 'active' : ''}}"><view class="switch-knob"></view></view><text>门前限定</text></view><text class="filter-count">{{filteredYaku.length}} 项役种</text></view>
  </view>

  <!-- 役种列表 -->
  <view class="yaku-list">
    <view class="yaku-card {{expandedIndex === index ? 'expanded' : ''}}"
          wx:for="{{filteredYaku}}" wx:key="_index">
      <!-- 头部 -->
      <view class="yaku-header" bindtap="onExpandTap" data-idx="{{index}}">
        <view class="yaku-title-area">
          <text class="yaku-name-cn">{{item.name}}</text>
          <text class="yaku-name-ja">{{item.nameJa}}</text>
        </view>
        <view class="yaku-badges">
          <text class="badge menzen" wx:if="{{item.menzenOnly}}">门前限定</text>
          <text class="badge han" wx:if="{{!item.isYakuman}}">{{item.han}}番</text>
          <text class="badge han open" wx:if="{{!item.isYakuman && item.hanOpen !== null && item.hanOpen !== item.han}}">副露{{item.hanOpen}}番</text>
          <text class="badge yakuman" wx:if="{{item.isYakuman && item.yakumanTimes === 1}}">役满</text>
          <text class="badge yakuman double" wx:if="{{item.isYakuman && item.yakumanTimes === 2}}">双倍役满</text><text class="yaku-chevron">{{expandedIndex === index ? '∧' : '›'}}</text>
        </view>
      </view>
      <!-- 简述 -->
      <text wx:if="{{expandedIndex === index}}" class="yaku-desc">{{item.desc}}</text>
      <!-- 展开详情 -->
      <view class="yaku-detail" wx:if="{{expandedIndex === index}}">
        <view class="detail-section">
          <text class="detail-label">成立条件</text>
          <text class="detail-text">{{item.condition}}</text>
        </view>
        <view class="detail-section" wx:if="{{item._handTiles}}">
          <text class="detail-label">示例牌型</text>
          <view class="example-pairs" wx:if="{{item._pairGroups}}"><view class="example-pair" wx:for="{{item._pairGroups}}" wx:for-item="pair" wx:key="index"><tile wx:for="{{pair}}" wx:for-item="pairTile" wx:key="index" tid="{{pairTile}}" size="picker"></tile></view></view>
          <view class="example-hand" wx:else>
            <tile wx:for="{{item._handTiles}}" wx:for-item="t" wx:key="index" tid="{{t}}" size="normal"></tile>
            <tile wx:if="{{item._agariTile !== undefined}}" tid="{{item._agariTile}}" size="normal" extra="agari"></tile>
          </view>
          <text class="example-note" wx:if="{{item.example.note}}">{{item.example.note}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{filteredYaku.length === 0}}">
    <text class="empty-symbol">役</text><text class="empty-text">没有找到匹配的役种</text><text class="empty-hint">试试其他名称，或调整筛选条件</text>
  </view>
</view>
