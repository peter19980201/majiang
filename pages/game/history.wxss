.history-page {
  padding:0 24rpx calc(36rpx + env(safe-area-inset-bottom));
}

.history-heading {
  position:relative;
  height:280rpx;
  margin:0 -24rpx 8rpx;
  padding:42rpx 32rpx 0;
  overflow:hidden;
}

.history-art {
  position:absolute;
  top:0;
  left:0;
  width:100%;
  height:100%;
  pointer-events:none;
}

.history-title-row {
  position:relative;
  display:flex;
  align-items:center;
  gap:18rpx;
}

.history-title {
  font-family:'Songti SC','STSong',serif;
  font-size:48rpx;
  font-weight:800;
  letter-spacing:2rpx;
  color:#142f29;
}

.history-seal {
  font-family:'Songti SC','STSong',serif;
  font-size:28rpx;
  line-height:1.12;
  padding:5rpx;
  border:2rpx solid #315647;
  border-radius:4rpx;
  color:#315647;
}

.current-game {
  background:linear-gradient(130deg,#eef2e7,#e2e9d8);
  border:1rpx solid #d6dfca;
  border-radius:24rpx;
  padding:26rpx;
  margin-bottom:30rpx;
}


.current-header {
  display:flex;
  align-items:center;
  gap:14rpx;
  font-size:22rpx;
}

.current-badge {
  background:#285943;
  color:#fff;
  padding:7rpx 14rpx;
  border-radius:9rpx;
}

.current-date {
  flex:1;
  color:#738467;
}

.current-type {
  color:#4d6945;
}

.current-info {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10rpx;
  margin:24rpx 0;
}

.current-round {
  font-size:33rpx;
  font-weight:600;
}

.current-supply {
  font-size:23rpx;
  color:#8f6e2b;
}

.current-players {
  display:flex;
  margin-bottom:24rpx;
}

.cp-item {
  flex:1;
  min-width:0;
  text-align:center;
  border-right:1rpx solid #cbd6bf;
}

.cp-item:last-child {
  border:0;
}

.cp-wind {
  display:block;
  width:54rpx;
  height:70rpx;
  line-height:64rpx;
  margin:0 auto 10rpx;
  font-family:'Songti SC','STSong',serif;
  font-size:37rpx;
  font-weight:700;
  background:#fcf8e8;
  border:1rpx solid #cfc9a9;
  border-radius:6rpx;
  box-shadow:0 4rpx 0 #b7ba9e;
}

.cp-name {
  display:block;
  font-size:22rpx;
  padding:0 4rpx;
  overflow:hidden;
  white-space:nowrap;
  text-overflow:ellipsis;
}

.cp-pts {
  display:block;
  font-size:30rpx;
  font-weight:600;
  margin-top:3rpx;
}

.current-actions {
  display:flex;
  gap:12rpx;
}

.current-btn {
  flex:1;
  text-align:center;
  padding:18rpx 4rpx;
  border-radius:15rpx;
  font-size:26rpx;
  font-weight:600;
}

.current-btn.resume {
  background:#2a5843;
  color:#fff;
}

.current-btn.abandon {
  border:1rpx solid #6f8d61;
  color:#385e3d;
  background:#f6f7ef;
}

.header {
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin:0 8rpx 18rpx;
}

.header-title {
  font-size:27rpx;
  font-weight:600;
}

.clear-all {
  font-size:23rpx;
  color:#7d826f;
  padding:10rpx;
}

.card {
  position:relative;
  overflow:hidden;
  padding:24rpx;
  margin-bottom:20rpx;
  box-shadow:0 4rpx 14rpx rgba(48,47,25,.045);
}

.card-bamboo {
  position:absolute;
  top:0;
  right:100rpx;
  width:210rpx;
  height:74rpx;
  overflow:hidden;
  opacity:.18;
  pointer-events:none;
}

.card-bamboo image {
  position:absolute;
  top:0;
  right:0;
  width:420rpx;
  height:175rpx;
}

.card-header,.rank-row {
  position:relative;
}

.card-header {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8rpx;
}

.card-info {
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:12rpx;
}

.card-date {
  font-size:27rpx;
  font-weight:600;
}

.card-type {
  font-size:23rpx;
  color:#637858;
}

.card-abandoned {
  font-size:20rpx;
  background:#f1e7ce;
  color:#997630;
  padding:3rpx 9rpx;
  border-radius:5rpx;
}

.card-right {
  display:flex;
  gap:12rpx;
  align-items:center;
  flex-shrink:0;
}

.card-delete {
  padding:8rpx;
  font-size:21rpx;
  color:#8c6f5c;
}

.card-arrow {
  font-size:31rpx;
  color:#75876b;
}

.rank-row {
  display:flex;
  margin-top:18rpx;
  padding:26rpx 0 6rpx;
  border-top:1rpx solid #e6e7da;
}

.rank-item {
  flex:1;
  min-width:0;
  text-align:center;
  padding:0 4rpx;
  border-right:1rpx solid #e8e5dc;
}

.rank-item:last-child {
  border-right:0;
}

.rank-num {
  display:inline-block;
  font-family:'Songti SC','STSong',serif;
  font-size:24rpx;
  line-height:1.4;
  color:#7c8a82;
  border-bottom:1rpx solid #dfe3da;
  padding-bottom:3rpx;
}

.rank-num.rank-1 {
  color:#204e40;
}

.rank-name {
  display:block;
  font-size:23rpx;
  margin-top:12rpx;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.rank-points {
  display:block;
  font-size:29rpx;
  margin-top:5rpx;
  font-weight:500;
  font-variant-numeric:tabular-nums;
}

.rank-pt {
  display:block;
  font-size:22rpx;
  margin-top:8rpx;
}

.current-game { position:relative; overflow:hidden; }
.current-art { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; }
.current-header,.current-info,.current-players,.current-actions { position:relative; z-index:1; }
.cp-tile { margin-bottom:14rpx; line-height:0; }
.current-round { font-family:'Songti SC','STSong',serif; font-weight:700; }

.history-card-pressed { opacity:.85; transform:scale(.985); }
.history-settlement-mask { position:fixed; inset:0; z-index:200; display:flex; align-items:flex-end; visibility:hidden; pointer-events:none; background:rgba(8,25,20,0); transition:background-color 220ms ease-out,visibility 0s 220ms; }
.history-settlement-mask.is-open { visibility:visible; pointer-events:auto; background:rgba(8,25,20,.58); transition:background-color 280ms ease-out,visibility 0s; }
.history-settlement-sheet { display:flex; flex-direction:column; width:100%; height:96%; background:#faf8ef; border-radius:42rpx 42rpx 0 0; overflow:hidden; transform:translate3d(0,100%,0); transition:transform 220ms cubic-bezier(.32,.72,0,1); }
.is-open .history-settlement-sheet { transform:translate3d(0,0,0); transition-duration:280ms; }
.settlement-grip { width:72rpx; height:9rpx; flex-shrink:0; border-radius:8rpx; background:#d6d5cf; margin:20rpx auto 12rpx; }
.settlement-drawer-heading { display:flex; align-items:center; gap:20rpx; padding:0 28rpx 12rpx; color:#103c35; font-size:30rpx; font-weight:600; }
.settlement-drawer-heading .settlement-close { display:flex; align-items:center; justify-content:center; flex:0 0 54rpx; min-width:54rpx!important; max-width:54rpx; margin:0 0 0 auto!important; padding:0!important; width:54rpx!important; height:54rpx; line-height:1; border-radius:50%; font-size:42rpx; font-weight:300; color:#344b47; background:#eeede5; }
.settlement-drawer-content { flex:1; min-height:0; }
@media (prefers-reduced-motion:reduce) { .history-settlement-mask,.history-settlement-mask.is-open,.history-settlement-sheet { transition:none; } }
