.history-page {
  padding:0 24rpx calc(36rpx + env(safe-area-inset-bottom));
}

.history-heading {
  position:relative;
  min-height:168rpx;
  margin:0 -24rpx 20rpx;
  padding:36rpx 32rpx 20rpx;
  overflow:hidden;
}

.history-art {
  position:absolute;
  top:0;
  left:0;
  width:100%;
  height:100%;
  pointer-events:none;
}

.history-title-row {
  position:relative;
  display:flex;
  align-items:center;
  gap:18rpx;
}

.history-title {
  font-family:'Songti SC','STSong',serif;
  font-size:var(--font-display, 48rpx);
  font-weight:800;
  letter-spacing:2rpx;
  color:#142f29;
}

.history-seal {
  font-family:'Songti SC','STSong',serif;
  font-size:var(--font-body, 28rpx);
  line-height:1.12;
  padding:5rpx;
  border:2rpx solid #315647;
  border-radius:4rpx;
  color:#315647;
}

.header {
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin:0 8rpx 20rpx;
}

.header-title {
  font-size:var(--font-body, 28rpx);
  font-weight:600;
}

.clear-all {
  font-size:var(--font-small, 24rpx);
  color:#7d826f;
  padding:10rpx;
}

.card {
  position:relative;
  overflow:hidden;
  padding:24rpx;
  margin-bottom:20rpx;
  box-shadow:0 4rpx 14rpx rgba(48,47,25,.045);
}

.card-bamboo {
  position:absolute;
  top:0;
  right:100rpx;
  width:210rpx;
  height:74rpx;
  overflow:hidden;
  opacity:.18;
  mix-blend-mode:multiply;
  -webkit-mask-image:radial-gradient(ellipse at 70% 0%,#000 15%,transparent 75%);
  mask-image:radial-gradient(ellipse at 70% 0%,#000 15%,transparent 75%);
  pointer-events:none;
}

.card-bamboo image {
  position:absolute;
  top:0;
  right:0;
  width:420rpx;
  height:175rpx;
}

.card-header,.rank-row {
  position:relative;
}

.card-header {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8rpx;
}

.card-info {
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:12rpx;
}

.card-date {
  font-size:var(--font-body, 28rpx);
  font-weight:600;
}

.card-type {
  font-size:var(--font-small, 24rpx);
  color:#637858;
}

.card-abandoned {
  font-size:var(--font-caption, 22rpx);
  background:#f1e7ce;
  color:#997630;
  padding:3rpx 9rpx;
  border-radius:5rpx;
}

.rank-row {
  display:flex;
  margin-top:18rpx;
  padding:26rpx 0 6rpx;
  border-top:1rpx solid #e6e7da;
}

.rank-item {
  flex:1;
  min-width:0;
  text-align:center;
  padding:0 4rpx;
  border-right:1rpx solid #e8e5dc;
}

.rank-item:last-child {
  border-right:0;
}

.rank-num {
  display:inline-block;
  font-family:'Songti SC','STSong',serif;
  font-size:var(--font-small, 24rpx);
  line-height:1.4;
  color:#7c8a82;
  border-bottom:1rpx solid #dfe3da;
  padding-bottom:3rpx;
}

.rank-num.rank-1 {
  color:#204e40;
}

.rank-name {
  display:block;
  font-size:var(--font-small, 24rpx);
  margin-top:12rpx;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.rank-points {
  display:block;
  font-size:var(--font-body, 28rpx);
  margin-top:5rpx;
  font-weight:500;
  font-variant-numeric:tabular-nums;
}

.rank-pt {
  display:block;
  font-size:var(--font-caption, 22rpx);
  margin-top:8rpx;
}

.history-card-pressed { opacity:.85; transform:scale(.985); }
.history-settlement-mask { position:fixed; inset:0; z-index:200; display:flex; align-items:flex-end; visibility:hidden; pointer-events:none; background:rgba(8,25,20,0); transition:background-color 220ms ease-out,visibility 0s 220ms; }
.history-settlement-mask.is-open { visibility:visible; pointer-events:auto; background:rgba(8,25,20,.58); transition:background-color 280ms ease-out,visibility 0s; }
.history-settlement-sheet { display:flex; flex-direction:column; width:100%; height:96%; background:#faf8ef; border-radius:42rpx 42rpx 0 0; overflow:hidden; transform:translate3d(0,100%,0); transition:transform 220ms cubic-bezier(.32,.72,0,1); }
.is-open .history-settlement-sheet { transform:translate3d(0,0,0); transition-duration:280ms; }
.settlement-grip { width:72rpx; height:9rpx; flex-shrink:0; border-radius:8rpx; background:#d6d5cf; margin:20rpx auto 12rpx; }
.settlement-drawer-heading { display:flex; align-items:center; gap:20rpx; padding:0 28rpx 12rpx; color:#103c35; font-size:var(--font-label, 32rpx); font-weight:600; }
.settlement-drawer-heading .settlement-close { display:flex; align-items:center; justify-content:center; flex:0 0 54rpx; min-width:54rpx!important; max-width:54rpx; margin:0 0 0 auto!important; padding:0!important; width:54rpx!important; height:54rpx; line-height:1; border-radius:50%; font-size:var(--font-title, 40rpx); font-weight:300; color:#344b47; background:#eeede5; }
.settlement-drawer-content { flex:1; min-height:0; }
@media (prefers-reduced-motion:reduce) { .history-settlement-mask,.history-settlement-mask.is-open,.history-settlement-sheet { transition:none; } }

.history-page { padding-bottom:calc(140rpx + env(safe-area-inset-bottom)); }

@import '/styles/felt.wxss';

.list { margin:0 -24rpx; padding:0 24rpx; }
.history-row { margin-bottom:20rpx; }
.history-row .card { margin:0; }
.header-title { color:#697268; font-size:var(--font-small, 24rpx); font-weight:400; }

/* A fixed-width border avoids layout changes when toggling favorites. */
.history-row .card { border:3rpx solid #9aaa98; }
.history-row .card.is-favorite { border-color:#bd9650; }
.card-info { flex:1; min-width:0; }
.card-action { display:flex; align-items:center; justify-content:center; flex:0 0 44px; width:44px; min-width:44px; height:44px; margin:0; padding:0; background:transparent; border-radius:50%; line-height:1; }
.card-action::after,.history-filter::after { border:0; }
.card-action image { width:24px; height:24px; pointer-events:none; }
.favorite-pressed { background:rgba(189,150,80,.12); }
.history-filters { display:flex; gap:8rpx; padding:6rpx; margin:0 0 24rpx; border:1rpx solid #d8ded2; border-radius:18rpx; background:#efefe5; }
.history-filter { flex:1; min-width:0; margin:0; padding:18rpx 12rpx; border-radius:13rpx; background:transparent; color:#6b7668; font-size:var(--font-body, 28rpx); line-height:1.4; }
.history-filter text { margin-left:8rpx; font-size:var(--font-small, 24rpx); opacity:.8; }
.history-filter.is-active { background:#285943; color:#fff; }

.card-header { align-items:flex-start; }
.card-actions { display:flex; flex:0 0 auto; align-items:center; gap:2rpx; margin:-10px -8px -10px 0; }
.delete-button image { width:22px; height:22px; }
.delete-pressed { background:rgba(173,81,73,.1); }

.history-search-wrap { display:flex; align-items:center; gap:20rpx; height:88rpx; padding:0 24rpx; margin-bottom:20rpx; border:1rpx solid #b8c3b1; border-radius:18rpx; background:#fdfcf8; }
.history-search { flex:1; min-width:0; height:88rpx; color:#183e32; font-size:var(--font-body, 28rpx); }
.history-search-placeholder { color:#9ca597; font-size:var(--font-small, 24rpx); }

.history-search-icon {
  width:27rpx;
  height:27rpx;
  border:3rpx solid #647565;
  border-radius:50%;
  position:relative;
  flex-shrink:0;
}

.history-search-icon::after {
  content:'';
  position:absolute;
  width:14rpx;
  height:3rpx;
  background:#647565;
  right:-10rpx;
  bottom:-5rpx;
  transform:rotate(48deg);
}
