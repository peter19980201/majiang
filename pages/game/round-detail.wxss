page { background:#f7f5ee; color:#183e32; }
.detail-page { padding:32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom)); }
.detail-heading { display:flex; align-items:center; gap:16rpx; margin:8rpx 0 28rpx; }
.detail-round { font-family:'Songti SC','STSong',serif; font-size:var(--font-display, 48rpx); font-weight:700; }
.detail-honba,.result-type { padding:8rpx 18rpx; border-radius:10rpx; background:#e7ebdf; font-size:var(--font-small, 24rpx); color:#426552; }
.detail-card { padding:28rpx; background:#fffdf9; border:1rpx solid #e7e0d2; border-radius:24rpx; margin-bottom:20rpx; box-shadow:0 6rpx 20rpx rgba(52,47,27,.04); }
.result-row { display:flex; align-items:center; gap:18rpx; }
.winner { font-size:var(--font-heading, 36rpx); font-weight:600; overflow-wrap:break-word; }
.result-score { font-size:var(--font-score, 64rpx); font-weight:700; font-variant-numeric:tabular-nums; margin:18rpx 0 12rpx; }
.result-score text { font-size:var(--font-body, 28rpx); margin-left:8rpx; font-weight:400; }
.detail-title { display:block; font-size:var(--font-body, 28rpx); font-weight:600; margin-bottom:22rpx; }
.detail-note { display:block; color:#7b8275; font-size:var(--font-small, 24rpx); line-height:1.7; }
.result-meta,.detail-tags { display:flex; flex-wrap:wrap; gap:12rpx; margin:16rpx 0; }
.result-meta { color:#716946; font-size:var(--font-body, 28rpx); }
.yaku-tag { padding:10rpx 18rpx; background:#e9eddf; color:#416350; border-radius:10rpx; font-size:var(--font-small, 24rpx); }
.points-row { display:flex; align-items:center; justify-content:space-between; gap:20rpx; padding:20rpx 0; border-top:1rpx solid #eeebe3; }
.points-player { min-width:0; font-size:var(--font-body, 28rpx); }
.points-player text { display:block; }
.points-transition { color:#828779; font-size:var(--font-small, 24rpx); margin-top:6rpx; }
.points-delta { flex-shrink:0; font-size:var(--font-label, 32rpx); font-weight:600; font-variant-numeric:tabular-nums; }
.legacy-note { display:block; font-size:var(--font-small, 24rpx); line-height:1.7; color:#818575; padding:4rpx 8rpx 20rpx; }
.detail-actions { display:flex; gap:18rpx; margin-top:32rpx; }
.detail-actions button { flex:1; min-width:0; margin:0; font-size:var(--font-body, 28rpx); border-radius:16rpx; line-height:88rpx; }
.detail-actions button::after { border:0; }
.delete-button { background:#fffaf4; border:1rpx solid #d8c5b9; color:#a34e40; }
.edit-button { background:#204e40; color:#fffdf6; border:1rpx solid #204e40; }
.detail-actions button[disabled] { color:#a2a598; background:#eeeee6; border-color:#e0e1d7; }
