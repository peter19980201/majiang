<page-meta page-style="{{settlementVisible ? 'overflow: hidden;' : ''}}"></page-meta>
<image class="page-landscape page-landscape-tab" src="/assets/home/profile-landscape.jpg" mode="aspectFill" aria-hidden="true" />
<image class="page-motto-art" src="/assets/home/profile-motto.png" mode="aspectFit" aria-label="以牌会友，乐在其中" />
<wxs module="fmt" src="../../utils/format.wxs"></wxs>
<wxs module="swipe" src="../../utils/history-swipe.wxs"></wxs>
<view class="container history-page" swipe-reset="{{swipeReset}}" change:swipe-reset="{{swipe.reset}}">
  <view class="history-heading">
    <view class="history-title-row"><text class="history-title">历史对局</text><text class="history-seal">史</text></view>
  </view>
  <!-- 进行中的对局 -->
  <view class="current-game" wx:if="{{currentGame}}">
    <image class="current-art" src="/assets/home/resume.jpg" mode="scaleToFill" aria-hidden="true"></image>
    <view class="current-header">
      <view class="current-badge">进行中</view>
      <text class="current-date">{{currentGame.date}}</text>
      <text class="current-type">{{currentGame.gameState.config.gameType === 'free' ? '自由记分' : currentGame.gameState.config.gameType === 'hanchan' ? '半庄' : '东风'}}</text>
    </view>
    <view class="current-info">
      <text class="current-round">{{currentGame.gameState.roundCycle > 1 ? '第' + currentGame.gameState.roundCycle + '轮 · ' : ''}}{{currentGame.gameState.roundWindName}}{{currentGame.gameState.roundNum}}局 {{currentGame.gameState.honba}}本场</text>
      <text class="current-supply" wx:if="{{currentGame.gameState.riichiSticks > 0}}">供托 {{fmt.points(currentGame.gameState.riichiSticks * 1000)}} 点</text>
    </view>
    <view class="current-players">
      <view class="cp-item" wx:for="{{currentGame.gameState.players}}" wx:key="index">
        <view class="cp-tile"><tile tid="{{27 + index * 1}}" size="small"></tile></view><text class="cp-name">{{item.name}}</text>
        <text class="cp-pts {{item.points < currentGame.gameState.config.startPoints ? 'negative' : 'positive'}}">{{fmt.points(item.points)}}</text>
      </view>
    </view>
    <view class="current-actions">
      <text class="current-btn resume" bindtap="resumeGame">继续对局</text>
      <text class="current-btn abandon" bindtap="abandonGame">结束并结算</text>
    </view>
  </view>

  <view class="header" wx:if="{{historyList.length > 0}}">
    <text class="header-title">共 {{historyList.length}} 场已完成对局</text>
  </view>

  <view class="list">
    <view class="swipe-row" wx:for="{{historyList}}" wx:key="id">
      <button class="swipe-delete" catchtap="deleteRecord" data-id="{{item.id}}" aria-label="删除{{item.date}}的对局">删除</button>
      <view class="card" bindtap="{{swipe.tap}}" data-id="{{item.id}}" bindtouchstart="{{swipe.start}}" bindtouchmove="{{swipe.move}}" bindtouchend="{{swipe.end}}" bindtouchcancel="{{swipe.cancel}}">
      <view class="card-bamboo" aria-hidden="true"><image src="/assets/home/header.jpg" mode="scaleToFill"></image></view>
      <view class="card-header">
        <view class="card-info">
          <text class="card-date">{{item.date}}</text>
          <text class="card-type">{{item.config.gameType === 'free' ? '自由记分' : item.config.gameType === 'hanchan' ? '半庄' : '东风'}}</text>
          <text class="card-abandoned" wx:if="{{item.abandoned}}">中断</text>
        </view>
      </view>
      <!-- 排名摘要 -->
      <view class="rank-row">
        <view class="rank-item" wx:for="{{item.result}}" wx:for-item="r" wx:key="rank">
          <text class="rank-num rank-{{r.rank}}">{{rankLabels[r.rank - 1]}}</text>
          <text class="rank-name">{{r.name}}</text><text class="rank-points">{{fmt.points(r.points)}}</text>
          <text class="rank-pt {{r.finalPt >= 0 ? 'positive' : 'negative'}}">{{r.finalPt >= 0 ? '+' : ''}}{{r.finalPt}}</text>
        </view>
      </view>

      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{historyList.length === 0 && !currentGame}}">
    <text class="empty-symbol">局</text><text class="empty-text">还没有对局记录</text><text class="empty-hint">完成一场对局后，在这里回顾每一局</text>
  </view>
  <view class="local-note">仅保存在当前设备 · 历史记录持续保留</view>
  <view class="history-settlement-mask {{settlementVisible ? 'is-open' : ''}}" bindtap="closeSettlement" aria-hidden="{{!settlementVisible}}">
    <view class="history-settlement-sheet" catchtap="stopBubble">
      <view class="settlement-grip" catchtouchmove="stopBubble"></view>
      <view class="settlement-drawer-heading" catchtouchmove="stopBubble"><text>对局结算</text><button class="settlement-close" bindtap="closeSettlement" aria-label="关闭结算">×</button></view>
      <view class="settlement-drawer-content"><settlement-view report="{{settlementReport}}"/></view>
    </view>
  </view>
</view>
