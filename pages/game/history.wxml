<page-meta page-style="{{settlementVisible ? 'overflow: hidden;' : ''}}"></page-meta>
<image class="page-landscape page-landscape-tab" src="/assets/home/profile-landscape.jpg" mode="aspectFill" aria-hidden="true" />
<image class="page-motto-art" src="/assets/home/profile-motto.png" mode="aspectFit" aria-label="以牌会友，乐在其中" />
<wxs module="fmt" src="../../utils/format.wxs"></wxs>
<view class="container history-page">
  <view class="history-heading">
    <view class="history-title-row"><text class="history-title">历史对局</text><text class="history-seal">史</text></view>
  </view>
  <input class="history-search" value="{{searchQuery}}" bindinput="onSearchInput" placeholder="输入名字，多个名字用空格分隔" placeholder-class="history-search-placeholder" aria-label="按参与者名字搜索，多个名字用空格分隔，需全部匹配" maxlength="-1" confirm-type="search" />
  <view class="history-filters" role="tablist" aria-label="筛选历史对局">
    <button class="history-filter {{historyFilter === 'all' ? 'is-active' : ''}}" data-filter="all" bindtap="changeFilter" role="tab" aria-selected="{{historyFilter === 'all'}}">全部 <text>{{totalCount}}</text></button>
    <button class="history-filter {{historyFilter === 'favorites' ? 'is-active' : ''}}" data-filter="favorites" bindtap="changeFilter" role="tab" aria-selected="{{historyFilter === 'favorites'}}">收藏 <text>{{favoriteCount}}</text></button>
  </view>
  <view class="header" wx:if="{{historyList.length > 0}}">
    <text class="header-title">{{historyFilter === 'favorites' ? '已收藏' : '共'}} {{historyList.length}} 场{{historyFilter === 'favorites' ? '对局' : '已完成对局'}}</text>
  </view>

  <view class="list">
    <view class="history-row" wx:for="{{historyList}}" wx:key="id">
      <view class="card {{item.favorite ? 'is-favorite' : ''}}" bindtap="onExpandTap" data-id="{{item.id}}">
      <view class="card-bamboo" aria-hidden="true"><image src="/assets/home/header.jpg" mode="scaleToFill"></image></view>
      <view class="card-header">
        <view class="card-info">
          <text class="card-date">{{item.date}}</text>
          <text class="card-type">{{item.config.playerCount === 3 ? '三麻 · 自由记分' : item.config.gameType === 'free' ? '自由记分' : item.config.gameType === 'hanchan' ? '半庄' : '东风'}}</text>
          <text class="card-abandoned" wx:if="{{item.abandoned}}">中断</text>
        </view>
        <view class="card-actions">
        <button class="card-action favorite-button {{item.favorite ? 'is-favorite' : ''}}" catchtap="toggleFavorite" data-id="{{item.id}}" aria-label="{{item.favorite ? '取消收藏' : '收藏'}}{{item.date}}的对局" aria-pressed="{{item.favorite}}" hover-class="favorite-pressed"><image src="/assets/icons/{{item.favorite ? 'star-filled' : 'star-outline'}}.svg" aria-hidden="true" /></button>
        <button class="card-action delete-button" catchtap="deleteRecord" data-id="{{item.id}}" aria-label="删除{{item.date}}的对局" hover-class="delete-pressed"><image src="/assets/icons/trash.svg" aria-hidden="true" /></button>
        </view>
      </view>
      <!-- 排名摘要 -->
      <view class="rank-row">
        <view class="rank-item" wx:for="{{item.result}}" wx:for-item="r" wx:key="rank">
          <text class="rank-num rank-{{r.rank}}">{{rankLabels[r.rank - 1]}}</text>
          <text class="rank-name">{{r.name}}</text><text class="rank-points">{{fmt.points(r.points)}}</text>
          <text class="rank-pt {{r.finalPt >= 0 ? 'positive' : 'negative'}}">{{r.finalPt >= 0 ? '+' : ''}}{{r.finalPt}}</text>
        </view>
      </view>

      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{historyList.length === 0}}">
    <text class="empty-symbol">局</text><text class="empty-text">{{hasSearch ? '没有符合条件的对局' : historyFilter === 'favorites' ? '还没有收藏的对局' : '还没有对局记录'}}</text><text class="empty-hint">{{hasSearch ? '请检查参与者名字，或清空输入查看全部记录' : historyFilter === 'favorites' ? '点击对局右上角星标，收藏值得回顾的对局' : '完成一场对局后，在这里回顾每一局'}}</text>
  </view>
  <view class="local-note">仅保存在当前设备 · 历史记录持续保留</view>
  <view class="history-settlement-mask {{settlementVisible ? 'is-open' : ''}}" bindtap="closeSettlement" aria-hidden="{{!settlementVisible}}">
    <view class="history-settlement-sheet" catchtap="stopBubble">
      <drawer-handle bind:activate="closeSettlement" />
      <view class="settlement-drawer-heading" catchtouchmove="stopBubble"><text>对局结算</text><button class="settlement-close" bindtap="closeSettlement" aria-label="关闭结算">×</button></view>
      <view class="settlement-drawer-content"><settlement-view report="{{settlementReport}}"/></view>
    </view>
  </view>
</view>

<confirmation-dialog id="confirmation-dialog" />
