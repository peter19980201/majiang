<wxs module="fmt" src="../../utils/format.wxs"></wxs>
<view class="container">
  <image class="table-art" src="/assets/art/table-texture.jpg" mode="aspectFill" aria-hidden="true"></image>
  <view class="board-topline"><text>{{config.gameType === 'hanchan' ? '半庄战' : '东风战'}}</text><text>{{gameOver ? '对局已结束' : '对局进行中'}}</text></view>
  <view class="round-display"><view class="round-decoration left" aria-hidden="true"><tile tid="{{21}}" size="small"></tile><tile tid="{{31}}" size="mini"></tile></view><view class="round-bar"><text class="round-label">{{roundWindName}}{{roundNum}}局</text><view class="round-meta"><text>{{honba}}本场</text><text>供托 {{riichiSticks}} 本</text></view></view><view class="round-decoration right" aria-hidden="true"><tile tid="{{31}}" size="mini"></tile><tile tid="{{23}}" size="small"></tile></view></view>
  <view class="players-grid"><view class="player-card {{index * 1 === dealerIdx ? 'dealer' : ''}}" wx:for="{{players}}" wx:key="index"><view class="player-wind-badge"><tile tid="{{27 + item.seatWind}}" size="large"></tile></view><view class="player-data"><text class="player-name">{{item.name}}</text><text class="player-points {{item.points < 0 ? 'negative' : ''}}">{{fmt.points(item.points)}}</text></view><text class="dealer-mark" wx:if="{{index * 1 === dealerIdx}}">庄</text></view></view>
  <view class="table-total"><text>总点棒（含供托）</text><text class="total-value">{{fmt.points(players[0].points + players[1].points + players[2].points + players[3].points + riichiSticks * 1000)}}</text></view>
  <view class="board-actions" wx:if="{{!gameOver}}"><view class="board-action" bindtap="startRon"><text>荣和</text></view><view class="board-action" bindtap="startTsumo"><text>自摸</text></view><view class="board-action" bindtap="startDraw"><text>流局</text></view></view>
  <view class="btn-primary settlement-trigger" wx:if="{{gameOver}}" bindtap="doSettlement">查看结算</view>
  <!-- 局历史 -->
  <view class="section record-section">
    <view class="section-header"><text class="section-title">本局记录</text><text class="early-link" wx:if="{{roundHistory.length > 0 && !gameOver}}" bindtap="earlySettlement">提前结算 ›</text></view>
    <view class="board-empty" wx:if="{{roundHistory.length === 0}}">第一局，从这里开始。<text>录入结果后自动保存对局进度</text></view>
    <view class="history-list">
      <view class="history-item" wx:for="{{roundHistory}}" wx:key="index">
        <text class="hist-round">{{item.round}}</text>
        <view class="hist-content" wx:if="{{item.type === 'ron'}}">
          <text class="hist-desc">{{item.winner}} 荣和 {{item.loser}} {{fmt.points(item.points)}}点</text>
          <text class="hist-sub" wx:if="{{item.level || item.yakuSummary}}">{{item.level ? item.level + ' ' : ''}}{{item.yakuSummary}}</text>
        </view>
        <view class="hist-content" wx:if="{{item.type === 'tsumo'}}">
          <text class="hist-desc">{{item.winner}} 自摸 {{fmt.points(item.points)}}点</text>
          <text class="hist-sub" wx:if="{{item.level || item.yakuSummary}}">{{item.level ? item.level + ' ' : ''}}{{item.yakuSummary}}</text>
        </view>
        <text class="hist-desc" wx:if="{{item.type === 'draw'}}">流局 ({{item.tenpai}})</text>
      </view>
    </view>
  </view>

  <!-- 荣和弹窗 -->
  <view class="modal-mask" wx:if="{{showRonModal}}" bindtap="closeRon">
    <view class="modal-content tall" catchtap="stopBubble">
      <view class="modal-handle"></view>
      <text class="modal-title">荣和</text>
      <text class="modal-label">和了者</text>
      <view class="player-select">
        <text class="psel {{selectedWinner === index * 1 ? 'active' : ''}}"
              wx:for="{{players}}" wx:key="index"
              bindtap="selectRonWinner" data-idx="{{index}}">{{item.name}}</text>
      </view>
      <text class="modal-label">放铳者</text>
      <view class="player-select">
        <text class="psel {{selectedLoser === index * 1 ? 'active' : ''}} {{selectedWinner === index * 1 ? 'disabled' : ''}}"
              wx:for="{{players}}" wx:key="index"
              bindtap="selectRonLoser" data-idx="{{index}}">{{item.name}}</text>
      </view>
      <text class="modal-label">本局立直<text class="riichi-info" wx:if="{{riichiSticks > 0}}"> (场上供托{{riichiSticks}}本)</text></text>
      <view class="riichi-toggle-list">
        <view class="riichi-toggle-row" wx:for="{{players}}" wx:key="index"
              bindtap="toggleRoundRiichi" data-idx="{{index}}">
          <text class="riichi-toggle-name">{{item.name}}</text>
          <text class="riichi-toggle-check {{roundRiichi[index] ? 'on' : ''}}">{{roundRiichi[index] ? '✓' : '−'}}</text>
        </view>
      </view>
      <view class="modal-actions">
        <text class="modal-btn cancel" bindtap="closeRon">取消</text>
        <text class="modal-btn confirm" bindtap="goToCalcRon">计算点数</text>
      </view>
      <view class="manual-divider" bindtap="toggleManualInput">
        <view class="divider-line"></view>
        <text class="divider-text">{{showManualInput ? '收起' : '已知点数？手动输入'}}</text>
        <view class="divider-line"></view>
      </view>
      <view wx:if="{{showManualInput}}" class="manual-area">
        <input class="points-input" type="number" placeholder="点数 (不含本场)"
               value="{{inputPoints}}" bindinput="onPointsInput" />
        <text class="manual-confirm-btn" bindtap="confirmRon">手动确认</text>
      </view>
    </view>
  </view>

  <!-- 自摸弹窗 -->
  <view class="modal-mask" wx:if="{{showTsumoModal}}" bindtap="closeTsumo">
    <view class="modal-content tall" catchtap="stopBubble">
      <view class="modal-handle"></view>
      <text class="modal-title">自摸</text>
      <text class="modal-label">和了者</text>
      <view class="player-select">
        <text class="psel {{selectedWinner === index * 1 ? 'active' : ''}}"
              wx:for="{{players}}" wx:key="index"
              bindtap="selectTsumoWinner" data-idx="{{index}}">{{item.name}}</text>
      </view>
      <text class="modal-label">本局立直<text class="riichi-info" wx:if="{{riichiSticks > 0}}"> (场上供托{{riichiSticks}}本)</text></text>
      <view class="riichi-toggle-list">
        <view class="riichi-toggle-row" wx:for="{{players}}" wx:key="index"
              bindtap="toggleRoundRiichi" data-idx="{{index}}">
          <text class="riichi-toggle-name">{{item.name}}</text>
          <text class="riichi-toggle-check {{roundRiichi[index] ? 'on' : ''}}">{{roundRiichi[index] ? '✓' : '−'}}</text>
        </view>
      </view>
      <view class="modal-actions">
        <text class="modal-btn cancel" bindtap="closeTsumo">取消</text>
        <text class="modal-btn confirm" bindtap="goToCalcTsumo">录入手牌</text>
      </view>
      <view class="manual-divider" bindtap="toggleManualInput">
        <view class="divider-line"></view>
        <text class="divider-text">{{showManualInput ? '收起' : '已知点数？手动输入'}}</text>
        <view class="divider-line"></view>
      </view>
      <view wx:if="{{showManualInput}}" class="manual-area tsumo-manual-area">
        <text wx:if="{{selectedWinner < 0}}" class="payment-hint">请先选择和了者</text>
        <view wx:else class="payment-fields">
          <text class="modal-label">闲家各付</text>
          <input class="points-input" type="number" placeholder="如 700（不含本场）"
                 value="{{inputKoPayment}}" bindinput="onKoPaymentInput" />
          <block wx:if="{{selectedWinner !== dealerIdx}}">
            <text class="modal-label">庄家支付</text>
            <input class="points-input" type="number" placeholder="如 1300（不含本场）"
                   value="{{inputOyaPayment}}" bindinput="onOyaPaymentInput" />
          </block>
          <text class="payment-hint">本场自动追加：每家 {{honba * 100}} 点。场上及本局立直棒自动计入。</text>
        </view>
        <text class="manual-confirm-btn" bindtap="confirmTsumo">手动确认</text>
      </view>
    </view>
  </view>

  <!-- 流局弹窗 -->
  <view class="modal-mask" wx:if="{{showDrawModal}}" bindtap="closeDraw">
    <view class="modal-content tall" catchtap="stopBubble">
      <view class="modal-handle"></view>
      <text class="modal-title">流局</text>
      <text class="modal-label">本局立直<text class="riichi-info" wx:if="{{riichiSticks > 0}}"> (场上供托{{riichiSticks}}本)</text></text>
      <view class="riichi-toggle-list">
        <view class="riichi-toggle-row" wx:for="{{players}}" wx:key="index"
              bindtap="toggleRoundRiichi" data-idx="{{index}}">
          <text class="riichi-toggle-name">{{item.name}}</text>
          <text class="riichi-toggle-check {{roundRiichi[index] ? 'on' : ''}}">{{roundRiichi[index] ? '✓' : '−'}}</text>
        </view>
      </view>
      <text class="modal-label">听牌情况</text>
      <view class="tenpai-list">
        <view class="tenpai-row {{drawTenpai[index] ? 'selected' : ''}}" wx:for="{{players}}" wx:key="index"
              bindtap="toggleTenpai" data-idx="{{index}}">
          <text class="tenpai-name">{{item.name}}</text>
          <text class="tenpai-check {{drawTenpai[index] ? 'on' : ''}}">{{drawTenpai[index] ? '听牌' : '不听'}}</text>
        </view>
      </view>
      <view class="draw-preview"><view class="draw-preview-title">{{drawTenpaiCount > 0 && drawTenpaiCount < 4 ? '不听罚符共 3,000 点' : '本局无不听罚符'}}</view><view class="draw-preview-grid"><view class="draw-preview-row" wx:for="{{drawPreview}}" wx:key="index"><text>{{item.name}}</text><text class="{{item.delta >= 0 ? 'positive' : 'negative'}}">{{item.delta > 0 ? '+' : ''}}{{item.delta}}</text></view></view><text class="preview-note">显示点棒变化，含本局立直支出</text></view>
      <view class="modal-actions">
        <text class="modal-btn cancel" bindtap="closeDraw">取消</text>
        <text class="modal-btn confirm draw-confirm" bindtap="confirmDraw">确认流局</text>
      </view>
    </view>
  </view>

  <!-- 结算弹窗 -->
  <view class="modal-mask" wx:if="{{showResultModal}}" bindtap="closeResult">
    <view class="modal-content tall" catchtap="stopBubble">
      <view class="modal-handle"></view>
      <text class="modal-title">对局结算</text>
      <text class="modal-subtitle">返还 {{config.returnPoints}} · 顺位马 {{config.uma}}</text>
      <view class="settlement-list"><view class="settlement-card rank-{{item.rank}}" wx:for="{{finalResult}}" wx:key="rank"><text class="settlement-rank">{{item.rank}}</text><view class="settlement-main"><text class="settlement-name">{{item.name}}</text><text class="settlement-points">{{fmt.points(item.points)}}<text> 点</text></text><text class="settlement-final {{item.finalPt >= 0 ? 'positive' : 'negative'}}">最终 {{item.finalPt >= 0 ? '+' : ''}}{{item.finalPt}}</text></view><view class="settlement-breakdown"><text>素点 {{item.rawPt >= 0 ? '+' : ''}}{{item.rawPt}}</text><text>马 {{item.uma >= 0 ? '+' : ''}}{{item.uma}}</text></view></view></view>
      <view class="modal-actions">
        <text class="modal-btn cancel" bindtap="goHistory">历史记录</text>
        <text class="modal-btn confirm" bindtap="goHome">返回首页</text>
      </view>
    </view>
  </view>
</view>
