.container {
  padding-bottom:calc(132rpx + env(safe-area-inset-bottom));
}

.section {
  padding:24rpx;
}

.seg {
  min-height:76rpx;
  font-size:28rpx;
}

.setting-row {
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:12rpx 0;
  gap:14rpx;
}

.setting-label {
  font-size:28rpx;
}

.step-val {
  min-width:170rpx;
}

.uma-grid {
  display:flex;
  gap:12rpx;
}

.uma-btn {
  flex:1;
  min-width:0;
  padding:16rpx 0;
  text-align:center;
  border:1rpx solid #dfdfd5;
  border-radius:14rpx;
  font-size:25rpx;
  background:#f8f7f1;
}

.uma-btn.active {
  background:#285342;
  border-color:#285342;
  color:#fff;
}

.player-list {
  display:flex;
  flex-direction:column;
  gap:16rpx;
}

.player-row {
  display:flex;
  align-items:center;
  gap:18rpx;
}

.player-wind {
  display:flex;
  align-items:center;
  justify-content:center;
  width:66rpx;
  flex-shrink:0;
  line-height:0;
}

.seat-label {
  font-size:26rpx;
  color:#526155;
  flex-shrink:0;
}

.player-input {
  flex:1;
  min-width:0;
  border:1rpx solid #d6dbd0;
  border-radius:13rpx;
  height:70rpx;
  padding:0 22rpx;
  background:#fdfcf7;
  font-size:28rpx;
}

.setup-bottom {
  position:fixed;
  bottom:0;
  left:0;
  right:0;
  background:#f6f4ed;
  padding:12rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  z-index:20;
}

.rule-row { display:flex; align-items:center; gap:24rpx; padding:22rpx 0; border-bottom:1rpx solid #e0e3d4; }
.rule-copy { flex:1; min-width:0; }
.rule-note { display:block; margin-top:10rpx; font-size:23rpx; line-height:1.6; color:#73816a; }
