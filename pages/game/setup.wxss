.container {
  padding-bottom:calc(208rpx + env(safe-area-inset-bottom));
}

.section {
  padding:24rpx;
}

.seg {
  min-height:76rpx;
  font-size:28rpx;
}

.setting-row {
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:12rpx 0;
  gap:14rpx;
}

.setting-label {
  font-size:28rpx;
}

.step-val {
  min-width:170rpx;
}

.uma-grid {
  display:flex;
  gap:12rpx;
}

.uma-btn {
  flex:1;
  min-width:0;
  padding:16rpx 0;
  text-align:center;
  border:1rpx solid #dfdfd5;
  border-radius:14rpx;
  font-size:25rpx;
  background:#f8f7f1;
}

.uma-btn.active {
  background:#285342;
  border-color:#285342;
  color:#fff;
}

.player-list {
  display:flex;
  flex-direction:column;
  gap:16rpx;
}

.player-row {
  display:flex;
  align-items:center;
  gap:18rpx;
}

.player-wind {
  font-family:'Songti SC','STSong',serif;
  font-size:36rpx;
  font-weight:700;
  width:66rpx;
  height:66rpx;
  line-height:60rpx;
  text-align:center;
  border:2rpx solid #b4ae95;
  border-radius:50%;
  background:linear-gradient(#fffef8,#e8e4d4);
  box-shadow:0 3rpx 0 #d0cbb9;
  flex-shrink:0;
}

.player-row:nth-child(2) .player-wind {
  color:#9e3c2e;
}

.seat-label {
  font-size:26rpx;
  color:#526155;
  flex-shrink:0;
}

.player-input {
  flex:1;
  min-width:0;
  border:1rpx solid #d6dbd0;
  border-radius:13rpx;
  height:70rpx;
  padding:0 22rpx;
  background:#fdfcf7;
  font-size:28rpx;
}

.setup-bottom {
  position:fixed;
  bottom:0;
  left:0;
  right:0;
  background:#f6f4ed;
  padding:12rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  z-index:20;
}

.setup-summary {
  font-size:24rpx;
  color:#496052;
  text-align:center;
  padding:12rpx;
  margin-bottom:12rpx;
  border-radius:12rpx;
  background:#e9ede3;
}


.setup-summary { display:flex; align-items:center; justify-content:center; gap:26rpx; }
.summary-tiles { display:flex; gap:4rpx; line-height:0; flex-shrink:0; }
.player-wind { background:radial-gradient(ellipse at 30% 20%,#fffef9,#f1ecd9 68%,#d6ceb4); box-shadow:inset 0 0 0 3rpx #fffc,0 3rpx 0 #b8ae8c,0 4rpx 6rpx #293a2414; }
