page {
  background:#103e31;
}

.container {
  background:radial-gradient(ellipse at 50% 15%,#1c503d,#103e31 75%);
  color:#fffdf3;
  padding:20rpx 24rpx 0;
  min-height:100vh;
}

.board-topline {
  display:flex;
  justify-content:space-between;
  font-size:23rpx;
  color:#a8c3ae;
  padding:0 4rpx;
}

.round-bar {
  width:410rpx;
  max-width:90%;
  border:1rpx solid #a4a276;
  border-radius:24rpx;
  margin:28rpx auto 36rpx;
  text-align:center;
  padding:16rpx 24rpx;
}

.round-label {
  display:block;
  font-family:'Songti SC','STSong',serif;
  font-size:58rpx;
  font-weight:700;
  letter-spacing:5rpx;
  color:#f0e7c1;
}

.round-meta {
  display:flex;
  justify-content:center;
  gap:28rpx;
  color:#e4e8d5;
  font-size:26rpx;
}

.players-grid {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:18rpx;
}

.player-card {
  position:relative;
  border:1rpx solid #76957c;
  border-radius:20rpx;
  padding:30rpx 18rpx;
  display:flex;
  gap:20rpx;
  align-items:center;
  background:rgba(255,255,255,.025);
  min-width:0;
  min-height:194rpx;
}

.player-card.dealer {
  border-color:#c9be7f;
  background:rgba(220,215,152,.05);
}


.player-data {
  flex:1;
  min-width:0;
}

.player-name {
  display:block;
  font-size:25rpx;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
  padding-right:10rpx;
}

.player-points {
  display:block;
  font-size:38rpx;
  font-weight:600;
  font-variant-numeric:tabular-nums;
  margin-top:8rpx;
}

.player-points.negative {
  color:#f3b3a3;
}

.dealer-mark {
  position:absolute;
  top:10rpx;
  right:10rpx;
  background:#dbc98b;
  color:#254130;
  border-radius:50%;
  width:34rpx;
  height:34rpx;
  line-height:34rpx;
  text-align:center;
  font-size:22rpx;
}

.table-total {
  display:flex;
  align-items:center;
  justify-content:center;
  gap:24rpx;
  padding:28rpx 0;
  font-size:23rpx;
  color:#c9d9c3;
}

.total-value {
  font-family:'Songti SC','STSong',serif;
  font-size:40rpx;
  color:#d9c78b;
  font-weight:600;
}

.board-actions {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:16rpx;
  margin-bottom:32rpx;
}

.board-action {
  border:1rpx solid #829b7e;
  background:linear-gradient(145deg,#2c5d49,#194a37);
  border-radius:22rpx;
  padding:24rpx 8rpx;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:16rpx;
  font-size:34rpx;
  font-weight:600;
}

.board-action:active {
  background:#356b50;
}

.settlement-trigger {
  margin:20rpx 0 30rpx;
  background:#ddcc91;
  color:#214330;
}

.record-section {
  margin:0 -24rpx;
  border:0;
  border-radius:32rpx 32rpx 0 0;
  padding:28rpx 28rpx calc(38rpx + env(safe-area-inset-bottom));
  min-height:240rpx;
  background:#f7f5ee;
  color:#24382b;
}

.early-link {
  font-size:23rpx;
  color:#4f7157;
  padding:8rpx;
}

.board-empty {
  color:#677b65;
  font-size:27rpx;
  text-align:center;
  padding:30rpx 0;
}

.board-empty text {
  display:block;
  color:#8b9582;
  font-size:22rpx;
  margin-top:8rpx;
}

.history-item {
  display:flex;
  gap:18rpx;
  align-items:baseline;
  padding:20rpx 0;
  border-top:1rpx solid #e0e3d4;
}

.hist-round {
  font-size:23rpx;
  color:#73816a;
  flex-shrink:0;
}

.hist-content {
  min-width:0;
}

.hist-desc {
  font-size:27rpx;
}

.hist-sub {
  display:block;
  font-size:22rpx;
  color:#7b876e;
  margin-top:6rpx;
}

.modal-label {
  display:block;
  font-size:27rpx;
  font-weight:600;
  margin:24rpx 0 14rpx;
}

.riichi-info {
  font-size:21rpx;
  font-weight:400;
  color:#75826c;
}

.player-select {
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:12rpx;
}

.psel {
  font-size:24rpx;
  padding:16rpx 5rpx;
  border:1rpx solid #d4d9c9;
  border-radius:13rpx;
  text-align:center;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.psel.active {
  color:#fff;
  background:#285440;
  border-color:#285440;
}

.psel.disabled {
  color:#a1a993;
  background:#eeeee4;
  opacity:.6;
}

.riichi-toggle-list {
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:10rpx;
}

.riichi-toggle-row {
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8rpx;
  padding:14rpx 4rpx;
  border:1rpx solid #dce0d0;
  border-radius:12rpx;
}

.riichi-toggle-name {
  font-size:22rpx;
  max-width:76rpx;
  overflow:hidden;
  white-space:nowrap;
  text-overflow:ellipsis;
}

.riichi-toggle-check {
  width:32rpx;
  height:32rpx;
  line-height:29rpx;
  text-align:center;
  border:1rpx solid #c6ceba;
  border-radius:50%;
  font-size:21rpx;
  color:#a3ac96;
  background:#eeeee2;
  flex-shrink:0;
}

.riichi-toggle-check.on {
  background:#315c43;
  border-color:#315c43;
  color:#fff;
}

.manual-divider {
  display:flex;
  gap:16rpx;
  align-items:center;
  padding:28rpx 0 18rpx;
}

.divider-line {
  flex:1;
  height:1rpx;
  background:#dbdfce;
}

.divider-text {
  font-size:24rpx;
  color:#4a6145;
}

.manual-area {
  display:flex;
  gap:14rpx;
}

.points-input {
  flex:1;
  min-width:0;
  height:84rpx;
  padding:0 18rpx;
  background:#fdfcf6;
  border:1rpx solid #d2d9c4;
  border-radius:14rpx;
  font-size:30rpx;
}

.manual-confirm-btn {
  display:flex;
  align-items:center;
  padding:0 20rpx;
  border:1rpx solid #99ab89;
  border-radius:14rpx;
  font-size:26rpx;
}

.tenpai-list {
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:10rpx;
}

.tenpai-row {
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:8rpx;
  padding:16rpx 6rpx;
  background:#efefe5;
  border:1rpx solid #d6dcca;
  border-radius:14rpx;
}

.tenpai-row.selected {
  background:#e4ecda;
  border-color:#507647;
}

.tenpai-name {
  width:100%;
  text-align:center;
  font-size:25rpx;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.tenpai-check {
  font-size:23rpx;
  color:#818a72;
}

.tenpai-check.on {
  color:#2c5f38;
  font-weight:600;
}

.draw-preview {
  border:1rpx solid #dce0d0;
  border-radius:16rpx;
  overflow:hidden;
  margin-top:24rpx;
}

.draw-preview-title {
  background:#e9ecdf;
  text-align:center;
  padding:16rpx;
  color:#3b5c3a;
  font-size:27rpx;
  font-weight:600;
}

.draw-preview-grid {
  display:grid;
  grid-template-columns:repeat(2,1fr);
}

.draw-preview-row {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8rpx;
  padding:15rpx;
  font-size:25rpx;
  border-top:1rpx solid #e4e6da;
}

.draw-preview-row text:first-child {
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.preview-note {
  display:block;
  text-align:center;
  color:#7c886e;
  font-size:21rpx;
  padding:12rpx;
}

.settlement-list {
  display:flex;
  flex-direction:column;
  gap:16rpx;
}

.settlement-card {
  display:flex;
  align-items:flex-start;
  gap:18rpx;
  border:1rpx solid #e0e2d2;
  background:#fdfcf7;
  padding:22rpx 18rpx;
  border-radius:20rpx;
}

.settlement-rank {
  width:50rpx;
  height:50rpx;
  line-height:50rpx;
  background:#9fa596;
  border-radius:50%;
  color:#fff;
  font-size:31rpx;
  text-align:center;
  flex-shrink:0;
}

.rank-1 .settlement-rank {
  background:#b69b50;
}

.rank-3 .settlement-rank {
  background:#b18b6f;
}

.settlement-main {
  flex:1;
  min-width:0;
}

.settlement-name {
  display:block;
  font-size:27rpx;
  font-weight:600;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.settlement-points {
  display:block;
  font-size:44rpx;
  line-height:1.4;
  font-weight:700;
}

.settlement-points text {
  font-size:22rpx;
  font-weight:400;
}

.settlement-final {
  display:block;
  font-size:26rpx;
  font-weight:600;
}

.rank-1 .settlement-final {
  color:#9b7829;
}

.settlement-breakdown {
  display:flex;
  flex-direction:column;
  gap:8rpx;
  font-size:23rpx;
  border-left:1rpx solid #d5dcc8;
  padding-left:16rpx;
  margin-top:26rpx;
  white-space:nowrap;
}

.container {
  display:flex;
  flex-direction:column;
}

.record-section {
  flex:1;
}

.container { position:relative; isolation:isolate; }
.table-art { position:absolute; inset:0; width:100%; height:100%; z-index:0; pointer-events:none; opacity:.30; }
.round-display { position:relative; }
.round-decoration { position:absolute; top:42rpx; display:flex; align-items:center; gap:5rpx; }
.round-decoration.left { left:4rpx; transform:rotate(-7deg); }
.round-decoration.right { right:4rpx; transform:rotate(7deg); }
.round-bar { background:rgba(8,43,32,.23); box-shadow:inset 0 1rpx 0 rgba(241,225,176,.14); }
.player-wind-badge { flex-shrink:0; line-height:0; }
.player-card { background:rgba(13,53,40,.32); box-shadow:inset 0 1rpx 0 rgba(255,255,255,.08); gap:18rpx; }
.player-points { font-family:'Songti SC','STSong',serif; font-size:40rpx; }
.board-action { background:rgba(38,89,67,.65); box-shadow:inset 0 1rpx 0 rgba(255,255,255,.12),0 5rpx 12rpx rgba(0,24,17,.1); }
.table-total::before,.table-total::after { content:''; flex:1; max-width:66rpx; height:1rpx; background:#a89964; }
.settlement-rank { background:linear-gradient(135deg,#c8ccc5,#8a948b); box-shadow:inset 0 1rpx 2rpx #fff8; }
.rank-1 .settlement-rank { background:linear-gradient(135deg,#e3c777,#ac7d28); }
.rank-3 .settlement-rank { background:linear-gradient(135deg,#d0ac88,#997454); }
.settlement-card { box-shadow:0 3rpx 10rpx rgba(38,42,23,.04); }

.board-topline,.round-display,.players-grid,.table-total,.board-actions,.record-section,.settlement-trigger { position:relative; z-index:1; }
