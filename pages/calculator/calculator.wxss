.calculator {
  padding:18rpx 22rpx calc(148rpx + env(safe-area-inset-bottom));
}

.section {
  padding:20rpx;
  margin-bottom:14rpx;
  border-radius:20rpx;
}

.section-title {
  font-size:26rpx;
  margin-bottom:14rpx;
}

.clear-btn,.add-meld-btn {
  font-size:23rpx;
  padding:8rpx 16rpx;
  border-radius:10rpx;
  color:#365d47;
  background:#eff1e8;
}

.clear-btn {
  background:transparent;
}

.tile-display-area {
  display:flex;
  flex-wrap:wrap;
  gap:6rpx;
  min-height:96rpx;
  align-items:flex-start;
  align-content:flex-start;
}

.tile-wrapper {
  display:inline-block;
  line-height:0;
}

.placeholder {
  width:100%;
  text-align:center;
  padding:30rpx 0;
  font-size:24rpx;
  color:#788578;
  border:1rpx dashed #d9dfd0;
  border-radius:12rpx;
}

.placeholder.small {
  padding:20rpx 0;
}

.row-sections {
  display:flex;
  gap:14rpx;
  margin-bottom:14rpx;
}

.row-sections .section {
  margin:0;
}

.flex-1 {
  width:180rpx;
  flex-shrink:0;
}

.flex-2 {
  flex:1;
  min-width:0;
}

.agari-area {
  justify-content:center;
}

.melds-row {
  display:flex;
  gap:10rpx;
  flex-wrap:wrap;
}

.meld-group {
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:4rpx;
}

.meld-tiles-row {
  display:flex;
  align-items:center;
  gap:2rpx;
  padding:10rpx;
  background:#eff1e8;
  border:1rpx solid #d9dfd0;
  border-radius:12rpx;
}

.meld-bottom {
  display:flex;
  align-items:center;
  gap:12rpx;
}

.meld-label {
  font-size:20rpx;
  color:#6e796d;
}

.meld-del {
  font-size:28rpx;
  color:#aa5140;
  padding:0 12rpx;
}

.meld-placeholder {
  width:100%;
  padding:28rpx 10rpx;
  color:#7b8678;
  font-size:23rpx;
  border:1rpx dashed #d9dfd0;
  border-radius:10rpx;
  text-align:center;
}

.target-tabs,.suit-tabs {
  display:flex;
  padding:4rpx;
  gap:4rpx;
  border-radius:14rpx;
  background:#eeeee7;
  margin-bottom:16rpx;
}

.tab,.suit-tab {
  flex:1;
  text-align:center;
  padding:12rpx 0;
  border-radius:11rpx;
  color:#566657;
  font-size:25rpx;
}

.tab.active,.suit-tab.active {
  background:#285441;
  color:#fffdf4;
}

.picker-row-lg {
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:14rpx 6rpx;
  padding:4rpx 0;
}

.picker-tile-lg {
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:5rpx;
}

.remain-badge-lg {
  font-size:21rpx;
  color:#6c796b;
}

.red-badge {
  color:#b35c4d;
}

.red-badge-on {
  font-weight:700;
  color:#b0362b;
}

.picker-row {
  display:flex;
  justify-content:space-between;
  margin-bottom:10rpx;
}

.picker-tile-sm {
  padding:3rpx 0;
}

.jihai-row {
  justify-content:flex-start;
  gap:12rpx;
}

.settings-grid {
  display:flex;
  flex-direction:column;
  gap:10rpx;
}

.setting-item {
  display:flex;
  align-items:center;
}

.setting-label {
  font-size:25rpx;
  width:92rpx;
  flex-shrink:0;
}

.setting-item .seg-ctrl {
  flex:1;
}

.setting-item .seg {
  min-height:50rpx;
  padding:5rpx;
}

.setting-item .stepper {
  flex:1;
}

.setting-item .step-val {
  flex:1;
}

.step-btn {
  height:54rpx;
  line-height:50rpx;
}

.step-val {
  height:54rpx;
  font-size:26rpx;
  padding:6rpx 18rpx;
}

.chip-grid {
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12rpx;
}

.chip {
  text-align:center;
  padding:16rpx 2rpx;
  font-size:23rpx;
  background:#efeee7;
  color:#586554;
  border:1rpx solid #e2e2d6;
  border-radius:13rpx;
}

.chip.on {
  background:#27533f;
  border-color:#27533f;
  color:#fff;
}

.dora-section {
  display:flex;
  flex-direction:column;
  gap:18rpx;
}

.dora-row {
  display:flex;
  align-items:center;
}

.dora-label {
  font-size:25rpx;
  min-width:120rpx;
}

.dora-tiles {
  display:flex;
  align-items:center;
  gap:12rpx;
  flex:1;
}

.dora-hint {
  font-size:22rpx;
  color:#858d7d;
}

.add-btn {
  width:52rpx;
  height:68rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#f3f3ea;
  border:1rpx dashed #cbd3c1;
  color:#6c8565;
  border-radius:8rpx;
  font-size:32rpx;
}

.dora-picker {
  background:#eeefe5;
  padding:16rpx;
  border-radius:14rpx;
}

.dora-picker-hint {
  display:block;
  text-align:center;
  font-size:23rpx;
  color:#506545;
  margin-bottom:16rpx;
}

.dora-picker-cancel {
  display:block;
  text-align:center;
  padding:14rpx;
  font-size:25rpx;
}

.sheet-heading {
  position:relative;
}

.sheet-close {
  position:absolute;
  right:0;
  top:0;
  padding:0 16rpx;
  font-size:38rpx;
  color:#76826d;
}

.meld-type-grid {
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10rpx;
}

.meld-type-btn {
  padding:24rpx 4rpx;
  background:#eeeee5;
  border-radius:16rpx;
  text-align:center;
}

.meld-type-icon {
  display:block;
  font-size:32rpx;
  color:#26503b;
  font-weight:600;
}

.meld-type-desc {
  display:block;
  font-size:19rpx;
  color:#718166;
  margin-top:8rpx;
}

.editing-meld-display {
  display:flex;
  min-height:108rpx;
  align-items:center;
  justify-content:center;
  gap:8rpx;
  padding:12rpx;
  margin-bottom:24rpx;
  background:#eeeee4;
  border-radius:16rpx;
}

.modal-picker {
  padding:0 8rpx;
}

.bc-tags {
  display:flex;
  gap:12rpx;
  flex-wrap:wrap;
}

.bc-tag {
  padding:5rpx 16rpx;
  border-radius:8rpx;
  background:#e2eadb;
  color:#355940;
  font-size:24rpx;
}

.br-score-section {
  text-align:center;
  padding:10rpx 0 24rpx;
  border-bottom:1rpx solid #dce0d2;
}

.br-level {
  display:block;
  font-size:26rpx;
  color:#9d701e;
}

.br-score-line {
  display:flex;
  align-items:baseline;
  justify-content:center;
  gap:18rpx;
}

.br-fuhan {
  font-size:26rpx;
}

.br-total {
  font-family:'Songti SC','STSong',serif;
  font-size:60rpx;
  font-weight:700;
  color:#31573d;
}

.br-payment,.br-sticks {
  display:block;
  margin-top:12rpx;
  font-size:24rpx;
  color:#64745a;
}

.br-sticks {
  color:#9d701e;
}

.br-yaku-list {
  max-height:260rpx;
  margin:16rpx 0;
}

.br-yaku-item {
  display:flex;
  justify-content:space-between;
  padding:16rpx 8rpx;
  border-bottom:1rpx solid #e7e8da;
  font-size:27rpx;
}

.br-yaku-han {
  color:#2d573b;
  font-weight:600;
}

.br-actions {
  display:flex;
  gap:14rpx;
}

.br-actions .modal-btn {
  flex:1;
}

.calc-bottom {
  position:fixed;
  bottom:0;
  left:0;
  right:0;
  padding:12rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background:#f6f4ed;
  border-top:1rpx solid #e3e3d6;
  z-index:100;
}

.calc-btn {
  font-size:30rpx;
}
