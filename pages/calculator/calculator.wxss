.calculator {
  padding:18rpx 22rpx calc(148rpx + env(safe-area-inset-bottom));
}

.section {
  padding:20rpx;
  margin-bottom:14rpx;
  border-radius:20rpx;
}

.section-title {
  font-size:var(--font-body, 28rpx);
  margin-bottom:14rpx;
}

.clear-btn,.add-meld-btn {
  font-size:var(--font-small, 24rpx);
  padding:8rpx 16rpx;
  border-radius:10rpx;
  color:#365d47;
  background:#eff1e8;
}

.clear-btn {
  background:transparent;
}

.tile-display-area {
  display:flex;
  flex-wrap:wrap;
  gap:6rpx;
  min-height:96rpx;
  align-items:flex-start;
  align-content:flex-start;
}

.tile-wrapper {
  display:inline-block;
  line-height:0;
}

.placeholder {
  width:100%;
  text-align:center;
  padding:30rpx 0;
  font-size:var(--font-small, 24rpx);
  color:#788578;
  border:1rpx dashed #d9dfd0;
  border-radius:12rpx;
}

.placeholder.small {
  padding:20rpx 0;
}

.row-sections {
  display:flex;
  gap:14rpx;
  margin-bottom:14rpx;
}

.row-sections .section {
  margin:0;
}

.flex-1 {
  width:180rpx;
  flex-shrink:0;
}

.flex-2 {
  flex:1;
  min-width:0;
}

.agari-area {
  justify-content:center;
}

.melds-row {
  display:flex;
  gap:10rpx;
  flex-wrap:wrap;
}

.meld-group {
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:4rpx;
}

.meld-tiles-row {
  display:flex;
  align-items:center;
  gap:2rpx;
  padding:10rpx;
  background:#eff1e8;
  border:1rpx solid #d9dfd0;
  border-radius:12rpx;
}

.meld-bottom {
  display:flex;
  align-items:center;
  gap:12rpx;
}

.meld-label {
  font-size:var(--font-caption, 22rpx);
  color:#6e796d;
}

.meld-del {
  font-size:var(--font-body, 28rpx);
  color:#aa5140;
  padding:0 12rpx;
}

.meld-placeholder {
  width:100%;
  padding:28rpx 10rpx;
  color:#7b8678;
  font-size:var(--font-small, 24rpx);
  border:1rpx dashed #d9dfd0;
  border-radius:10rpx;
  text-align:center;
}

.target-tabs,.suit-tabs {
  display:flex;
  padding:4rpx;
  gap:4rpx;
  border-radius:14rpx;
  background:#eeeee7;
  margin-bottom:16rpx;
}

.tab,.suit-tab {
  flex:1;
  text-align:center;
  padding:12rpx 0;
  border-radius:11rpx;
  color:#566657;
  font-size:var(--font-small, 24rpx);
}

.tab.active,.suit-tab.active {
  background:#285441;
  color:#fffdf4;
}

.picker-row-lg {
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:14rpx 6rpx;
  padding:4rpx 0;
}

.picker-tile-lg {
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:5rpx;
}

.remain-badge-lg {
  font-size:var(--font-caption, 22rpx);
  color:#6c796b;
}

.red-badge {
  color:#b35c4d;
}

.red-badge-on {
  font-weight:700;
  color:#b0362b;
}

.picker-row {
  display:flex;
  justify-content:space-between;
  margin-bottom:10rpx;
}

.picker-tile-sm {
  padding:3rpx 0;
}

.jihai-row {
  justify-content:flex-start;
  gap:12rpx;
}

.settings-grid {
  display:flex;
  flex-direction:column;
  gap:10rpx;
}

.setting-item {
  display:flex;
  align-items:center;
}

.setting-label {
  font-size:var(--font-small, 24rpx);
  width:92rpx;
  flex-shrink:0;
}

.setting-item .seg-ctrl {
  flex:1;
}

.setting-item .seg {
  min-height:50rpx;
  padding:5rpx;
}

.setting-item .stepper {
  flex:1;
}

.setting-item .step-val {
  flex:1;
}

.step-btn {
  height:54rpx;
  line-height:50rpx;
}

.step-val {
  height:54rpx;
  font-size:var(--font-body, 28rpx);
  padding:6rpx 18rpx;
}

.chip-grid {
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12rpx;
}

.chip {
  text-align:center;
  padding:16rpx 2rpx;
  font-size:var(--font-small, 24rpx);
  background:#efeee7;
  color:#586554;
  border:1rpx solid #e2e2d6;
  border-radius:13rpx;
}

.chip.on {
  background:#27533f;
  border-color:#27533f;
  color:#fff;
}

.dora-section {
  display:flex;
  flex-direction:column;
  gap:18rpx;
}

.dora-row {
  display:flex;
  align-items:center;
}

.dora-label {
  font-size:var(--font-small, 24rpx);
  min-width:120rpx;
}

.dora-tiles {
  display:flex;
  align-items:center;
  gap:12rpx;
  flex:1;
}

.dora-hint {
  font-size:var(--font-caption, 22rpx);
  color:#858d7d;
}

.add-btn {
  width:52rpx;
  height:68rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#f3f3ea;
  border:1rpx dashed #cbd3c1;
  color:#6c8565;
  border-radius:8rpx;
  font-size:var(--font-label, 32rpx);
}

.dora-picker {
  background:#eeefe5;
  padding:16rpx;
  border-radius:14rpx;
}

.dora-picker-hint {
  display:block;
  text-align:center;
  font-size:var(--font-small, 24rpx);
  color:#506545;
  margin-bottom:16rpx;
}

.dora-picker-cancel {
  display:block;
  text-align:center;
  padding:14rpx;
  font-size:var(--font-small, 24rpx);
}

.sheet-heading {
  position:relative;
}

.sheet-close {
  position:absolute;
  right:0;
  top:0;
  padding:0 16rpx;
  font-size:var(--font-title, 40rpx);
  color:#76826d;
}

.meld-type-grid {
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10rpx;
}

.meld-type-btn {
  padding:24rpx 4rpx;
  background:#eeeee5;
  border-radius:16rpx;
  text-align:center;
}

.meld-type-icon {
  display:block;
  font-size:var(--font-label, 32rpx);
  color:#26503b;
  font-weight:600;
}

.meld-type-desc {
  display:block;
  font-size:var(--font-caption, 22rpx);
  color:#718166;
  margin-top:8rpx;
}

.editing-meld-display {
  display:flex;
  min-height:108rpx;
  align-items:center;
  justify-content:center;
  gap:8rpx;
  padding:12rpx;
  margin-bottom:24rpx;
  background:#eeeee4;
  border-radius:16rpx;
}

.modal-picker {
  padding:0 8rpx;
}

.bc-tags {
  display:flex;
  gap:12rpx;
  flex-wrap:wrap;
}

.bc-tag {
  padding:5rpx 16rpx;
  border-radius:8rpx;
  background:#e2eadb;
  color:#355940;
  font-size:var(--font-small, 24rpx);
}

.br-score-section {
  text-align:center;
  padding:10rpx 0 24rpx;
  border-bottom:1rpx solid #dce0d2;
}

.br-level {
  display:block;
  font-size:var(--font-body, 28rpx);
  color:#9d701e;
}

.br-score-line {
  display:flex;
  align-items:baseline;
  justify-content:center;
  gap:18rpx;
}

.br-fuhan {
  font-size:var(--font-body, 28rpx);
}

.br-total {
  font-family:'Songti SC','STSong',serif;
  font-size:var(--font-score, 64rpx);
  font-weight:700;
  color:#31573d;
}

.br-payment,.br-sticks {
  display:block;
  margin-top:12rpx;
  font-size:var(--font-small, 24rpx);
  color:#64745a;
}

.br-sticks {
  color:#9d701e;
}

.br-yaku-list {
  max-height:260rpx;
  margin:16rpx 0;
}

.br-yaku-item {
  display:flex;
  justify-content:space-between;
  padding:16rpx 8rpx;
  border-bottom:1rpx solid #e7e8da;
  font-size:var(--font-body, 28rpx);
}

.br-yaku-han {
  color:#2d573b;
  font-weight:600;
}

.br-actions {
  display:flex;
  gap:14rpx;
}

.br-actions .modal-btn {
  flex:1;
}

.calc-bottom {
  position:fixed;
  bottom:0;
  left:0;
  right:0;
  padding:12rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background:#f6f4ed;
  border-top:1rpx solid #e3e3d6;
  z-index:100;
}

.calc-btn {
  font-size:var(--font-label, 32rpx);
}

.quick-links { display:flex; gap:16rpx; margin-bottom:20rpx; }
.quick-link { flex:1; text-align:center; padding:22rpx 8rpx; background:#e5eadf; border-radius:16rpx; color:#24483e; font-size:var(--font-body, 28rpx); font-weight:600; }

/* Unified felt surface for the hand, winning tile and open melds. */
.hand-table {
  position:relative;
  overflow:hidden;
  padding:24rpx;
  margin-bottom:18rpx;
  border:2rpx solid #698c79;
  border-radius:24rpx;
  background:#184d3c;
  color:#fffdf2;
}
.hand-table-texture {
  position:absolute;
  top:0;
  left:0;
  width:100%;
  height:100%;
  opacity:.5;
  pointer-events:none;
}
.hand-table .section {
  position:relative;
  padding:0;
  margin:0;
  border:0;
  border-radius:0;
  background:transparent;
  box-shadow:none;
}
.hand-table .section-title {
  color:#fffdf2;
  font-size:var(--font-body, 28rpx);
}
.hand-table .row-sections {
  position:relative;
  margin:24rpx 0 0;
  padding-top:22rpx;
  border-top:1rpx solid rgba(232,239,217,.4);
  gap:24rpx;
}
.hand-table .flex-1 {
  width:150rpx;
  padding-right:24rpx;
  border-right:1rpx solid rgba(232,239,217,.4);
}
.hand-slots {
  display:grid;
  grid-template-columns:repeat(13,minmax(0,1fr));
  gap:4rpx;
}
.hand-slot,.agari-slot {
  height:64rpx;
  min-width:0;
}
.hand-slot-filled { width:100%; height:100%; }
.hand-slot-empty {
  display:flex;
  align-items:center;
  justify-content:center;
  width:100%;
  height:100%;
  box-sizing:border-box;
  border:1rpx solid rgba(216,232,203,.5);
  border-radius:6rpx;
  background:rgba(223,235,211,.12);
  color:rgba(216,232,203,.4);
  font-size:var(--font-caption, 22rpx);
}
.agari-slot { width:46rpx; }
.hand-table .agari-area { min-height:64rpx; }
.hand-table .meld-placeholder {
  color:#d7e2d0;
  border-color:rgba(222,235,210,.6);
  padding:32rpx 10rpx;
}
.hand-table .clear-btn,.hand-table .add-meld-btn {
  color:#fffdf2;
  border:1rpx solid rgba(219,232,209,.35);
  background:rgba(230,239,221,.12);
}
.hand-table .meld-label { color:#dae5d5; }
.hand-table .meld-del { color:#f1cbb6; }

@import '/styles/felt.wxss';
