.home {
  padding:0 28rpx calc(24rpx + env(safe-area-inset-bottom));
}

.home-heading {
  position:relative;
  height:340rpx;
  margin:0 -28rpx;
  padding:36rpx 28rpx 0;
  overflow:hidden;
}

.title-row {
  display:flex;
  align-items:center;
  gap:14rpx;
  position:relative;
  z-index:2;
}

.home-title {
  font-family:'Songti SC','STSong',serif;
  font-size:48rpx;
  font-weight:800;
  letter-spacing:1rpx;
  color:#142f29;
}

.home-seal {
  font-family:'Songti SC','STSong',serif;
  font-size:29rpx;
  border:3rpx solid #315647;
  border-radius:5rpx;
  line-height:1.12;
  padding:4rpx;
  color:#315647;
}

.home-subtitle {
  display:block;
  margin-top:14rpx;
  color:#707970;
  font-size:26rpx;
  letter-spacing:7rpx;
}

.quick-card {
  position:relative;
  overflow:hidden;
  height:376rpx;
  border-radius:26rpx;
  padding:36rpx;
  color:#fffdf4;
  background:#194c3b;
  box-shadow:0 8rpx 18rpx rgba(27,48,28,.13);
}

.quick-title {
  display:block;
  font-family:'Songti SC','STSong',serif;
  font-size:48rpx;
  font-weight:700;
}

.quick-desc {
  display:block;
  font-size:26rpx;
  color:#e1e7dc;
  margin-top:10rpx;
}

.quick-cta {
  display:inline-flex;
  align-items:center;
  justify-content:space-between;
  gap:30rpx;
  margin-top:34rpx;
  background:#f8f5e9;
  color:#194435;
  padding:18rpx 30rpx;
  font-size:30rpx;
  font-weight:600;
  border-radius:100rpx;
}

.quick-arrow {
  font-size:36rpx;
  line-height:1;
}

.home-menu {
  margin-top:22rpx;
}

.menu-item {
  display:flex;
  align-items:center;
  gap:26rpx;
  padding:24rpx;
  margin-bottom:16rpx;
  min-height:132rpx;
  background:#fdfcf8;
  border:1rpx solid #eae7df;
  border-radius:22rpx;
  box-shadow:0 4rpx 9rpx rgba(39,46,25,.035);
}

.menu-item:active {
  background:#eeefe6;
}

.menu-icon {
  font-family:'Songti SC','STSong',serif;
  font-size:42rpx;
  font-weight:800;
  color:#275040;
  width:65rpx;
  text-align:center;
}

.menu-info {
  flex:1;
  min-width:0;
}

.menu-name {
  display:block;
  font-size:30rpx;
  font-weight:600;
}

.menu-desc {
  display:block;
  font-size:24rpx;
  color:#7a8076;
  margin-top:4rpx;
}

.menu-arrow {
  font-size:38rpx;
  color:#3d5247;
}

.home-footer {
  display:flex;
  align-items:center;
  justify-content:space-between;
  border-top:1rpx solid #dadccf;
  margin-top:28rpx;
  padding-top:14rpx;
  color:#697268;
  font-size:22rpx;
}

button.feedback-entry {
  flex:0 0 auto;
  width:auto!important;
  min-width:0!important;
  margin:0!important;
  padding:12rpx 0!important;
  text-align:left;
  background:transparent;
  color:#314a3c;
  line-height:1.5;
  font-size:24rpx;
}

.feedback-hover {
  opacity:.6;
}

.resume-card {
  position:relative;
  overflow:hidden;
  border:1rpx solid #dce3d5;
  background:linear-gradient(125deg,#eaf0e4,#e4e9dc);
  border-radius:24rpx;
  padding:28rpx;
}

.resume-badge {
  display:inline-block;
  background:#244d3e;
  color:#fff;
  padding:6rpx 14rpx;
  border-radius:9rpx;
  font-size:22rpx;
}

.resume-round {
  display:block;
  font-family:'Songti SC','STSong',serif;
  font-size:40rpx;
  font-weight:700;
  margin-top:18rpx;
}

.resume-players {
  display:flex;
  margin:24rpx 0;
}

.resume-player {
  flex:1;
  min-width:0;
  text-align:center;
  border-right:1rpx solid #c8d0bf;
}

.resume-player:last-child {
  border:0;
}

.resume-name {
  display:block;
  font-size:23rpx;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  padding:0 4rpx;
}

.resume-points {
  display:block;
  font-size:29rpx;
  font-weight:600;
  margin-top:4rpx;
}

.resume-actions {
  display:flex;
  gap:14rpx;
}

.resume-actions .btn-primary {
  flex:1.4;
}

.resume-actions .btn-secondary {
  flex:1;
}

/* Artwork is decorative; native controls and scores stay above it. */
.header-art,.card-art {
  position:absolute;
  top:0;
  left:0;
  width:100%;
  height:100%;
  pointer-events:none;
}
.home-subtitle,.quick-title,.quick-desc,.quick-cta,
.resume-badge,.resume-round,.resume-players,.resume-actions {
  position:relative;
  z-index:1;
}
.quick-desc { font-size:25rpx; }
.quick-cta { min-width:310rpx; }
