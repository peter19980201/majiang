.home {
  padding:0 28rpx calc(24rpx + env(safe-area-inset-bottom));
}

.home-heading {
  position:relative;
  height:340rpx;
  margin:0 -28rpx;
  padding:36rpx 28rpx 0;
  overflow:hidden;
}

.title-row {
  display:flex;
  align-items:center;
  gap:14rpx;
  position:relative;
  z-index:2;
}

.home-title {
  font-family:'Songti SC','STSong',serif;
  font-size:var(--font-display, 48rpx);
  font-weight:800;
  letter-spacing:1rpx;
  color:#142f29;
}

.home-seal {
  font-family:'Songti SC','STSong',serif;
  font-size:var(--font-body, 28rpx);
  border:3rpx solid #315647;
  border-radius:5rpx;
  line-height:1.12;
  padding:4rpx;
  color:#315647;
}

.home-subtitle {
  display:block;
  margin-top:14rpx;
  color:#707970;
  font-size:var(--font-body, 28rpx);
  letter-spacing:7rpx;
}







.menu-item {
  display:flex;
  align-items:center;
  gap:26rpx;
  padding:24rpx;
  margin-bottom:16rpx;
  min-height:132rpx;
  background:#fdfcf8;
  border:1rpx solid #eae7df;
  border-radius:22rpx;
  box-shadow:0 4rpx 9rpx rgba(39,46,25,.035);
}

.menu-item:active {
  background:#eeefe6;
}

.menu-icon {
  font-family:'Songti SC','STSong',serif;
  font-size:var(--font-title, 40rpx);
  font-weight:800;
  color:#275040;
  width:65rpx;
  text-align:center;
}


.menu-name {
  display:block;
  font-size:var(--font-label, 32rpx);
  font-weight:600;
}

.menu-desc {
  display:block;
  font-size:var(--font-small, 24rpx);
  color:#7a8076;
  margin-top:4rpx;
}

.menu-arrow {
  font-size:var(--font-title, 40rpx);
  color:#3d5247;
}

.home-footer {
  display:flex;
  align-items:center;
  justify-content:space-between;
  border-top:1rpx solid #dadccf;
  margin-top:28rpx;
  padding-top:14rpx;
  color:#697268;
  font-size:var(--font-caption, 22rpx);
}



.resume-card {
  position:relative;
  overflow:hidden;
  border:1rpx solid #dce3d5;
  background:linear-gradient(125deg,#eaf0e4,#e4e9dc);
  border-radius:24rpx;
  padding:28rpx;
}

.resume-badge {
  display:inline-block;
  background:#244d3e;
  color:#fff;
  padding:6rpx 14rpx;
  border-radius:9rpx;
  font-size:var(--font-caption, 22rpx);
}

.resume-round {
  display:block;
  font-family:'Songti SC','STSong',serif;
  font-size:var(--font-title, 40rpx);
  font-weight:700;
  margin-top:18rpx;
}

.resume-players {
  display:flex;
  margin:24rpx 0;
}

.resume-player {
  flex:1;
  min-width:0;
  text-align:center;
  border-right:1rpx solid #c8d0bf;
}

.resume-player:last-child {
  border:0;
}

.resume-name {
  display:block;
  font-size:var(--font-small, 24rpx);
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  padding:0 4rpx;
}

.resume-points {
  display:block;
  font-size:var(--font-body, 28rpx);
  font-weight:600;
  margin-top:4rpx;
}

.resume-actions {
  display:flex;
  gap:14rpx;
}

.resume-actions .btn-primary {
  flex:1.4;
}


/* Artwork is decorative; native controls and scores stay above it. */
.header-art,.card-art {
  position:absolute;
  top:0;
  left:0;
  width:100%;
  height:100%;
  pointer-events:none;
}
.home-subtitle,
.resume-badge,.resume-round,.resume-players,.resume-actions {
  position:relative;
  z-index:1;
}


/* Shared game slot keeps the two calculators stationary in both states. */
.home.tab-page { padding-bottom:calc(140rpx + env(safe-area-inset-bottom)); }
.resume-card { height:380rpx; display:flex; flex-direction:column; }
.resume-badge { align-self:flex-start; }
.resume-round { margin-top:12rpx; }
.resume-players { margin:18rpx 0; }
.resume-actions { margin-top:auto; }
.resume-actions .btn-primary,.resume-actions .btn-secondary { flex:1; width:0; min-width:0; margin:0; padding-left:12rpx; padding-right:12rpx; }
.resume-actions .resume-end { color:#7a5141; border-color:#cbb8a5; }
.resume-empty { position:relative; z-index:1; flex:1; display:flex; flex-direction:column; justify-content:center; text-align:center; gap:18rpx; }
.home-calculators { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18rpx; margin-top:22rpx; }
/* Both entry cards share the same quiet paper-and-bamboo treatment. */
.home-calculators .menu-item {
  position:relative;
  overflow:hidden;
  min-width:0;
  height:250rpx;
  box-sizing:border-box;
  margin:0;
  padding:22rpx 20rpx;
  flex-direction:column;
  align-items:flex-start;
  gap:12rpx;
  background:#f8f8ef;
  border-color:#d9ddcf;
  box-shadow:0 3rpx 8rpx rgba(39,46,25,.08);
}
.calculator-art {
  position:absolute;
  left:0;
  top:88rpx;
  width:100%;
  height:220rpx;
  opacity:.65;
  pointer-events:none;
}
.home-calculators .menu-item::after {
  content:'';
  position:absolute;
  inset:0;
  background:linear-gradient(180deg,#f8f8ef 0%,rgba(248,248,239,.95) 30%,rgba(248,248,239,0) 65%);
  pointer-events:none;
}
.home-calculators .menu-icon,
.home-calculators .menu-name,
.home-calculators .menu-desc,
.home-calculators .menu-arrow { position:relative; z-index:1; }
.home-calculators .menu-icon {
  display:flex;
  align-items:center;
  justify-content:center;
  width:60rpx;
  height:60rpx;
  flex-shrink:0;
  border:2rpx solid #d4dacb;
  border-radius:8rpx;
  background:rgba(225,230,216,.65);
  font-size:var(--font-display, 48rpx);
  line-height:1;
}
.home-calculators .menu-name { color:#142f29; font-weight:700; }
.home-calculators .menu-arrow { position:absolute; top:28rpx; right:20rpx; line-height:1; }
.home-calculators .menu-desc { margin-top:4rpx; font-size:var(--font-caption, 22rpx); line-height:1.6; }
.home-calculators .menu-item:active { opacity:.8; }
.home-footer { justify-content:center; }

@import '/styles/felt.wxss';
