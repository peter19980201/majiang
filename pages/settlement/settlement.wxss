page { background:#123f33; color:#103c32; }
.settlement-page { height:100vh; display:flex; flex-direction:column; overflow:hidden; position:relative; background:#fcfaf4; border-radius:24rpx 24rpx 0 0; color:#103c32; }
.settlement-scroll { flex:1; height:0; min-height:0; }
.settlement-content { padding:30rpx 28rpx 50rpx; }
.heading { padding:0 6rpx 24rpx; }
.title { display:block; font-size:var(--font-display, 48rpx); font-weight:700; line-height:1.4; }
.subtitle { display:flex; justify-content:space-between; gap:16rpx; margin-top:8rpx; font-size:var(--font-small, 24rpx); color:#62666d; }
.ranking { border:1rpx solid #e4e0d3; border-radius:14rpx; overflow:hidden; background:#fffdf7; }
.row { display:flex; align-items:center; min-height:96rpx; border-bottom:1rpx solid #e8e4d9; font-size:var(--font-label, 32rpx); padding:0 20rpx; }
.row:last-child { border-bottom:0; }
.table-head { min-height:68rpx; font-size:var(--font-small, 24rpx); background:#f1f3e9; color:#30434a; }
.rank { width:94rpx; flex:none; text-align:center; }
.name { display:flex; align-items:center; gap:22rpx; flex:1; min-width:0; padding:12rpx 8rpx 12rpx 24rpx; overflow-wrap:anywhere; }
.name tile { flex:none; }
.name text { min-width:0; }
.table-head .name { padding-left:42rpx; }
.points { width:150rpx; text-align:right; flex:none; font-variant-numeric:tabular-nums; }
.score { width:136rpx; text-align:right; flex:none; font-variant-numeric:tabular-nums; }
.negative { color:#65686d; }
.first { background:linear-gradient(110deg,#185344,#103f33); color:#fffdf5; font-weight:700; border-radius:12rpx 12rpx 0 0; }
.first .rank,.first .score { color:#dcc17c; }
.rules { display:flex; flex-direction:column; text-align:center; font-size:var(--font-small, 24rpx); line-height:1.7; margin:18rpx 0 34rpx; padding:16rpx 6rpx; border-radius:14rpx; background:#f0f3e8; }
.review-heading { display:flex; align-items:center; justify-content:space-between; font-size:var(--font-heading, 36rpx); font-weight:700; margin:0 4rpx 24rpx; }
.review-count { font-size:var(--font-small, 24rpx); color:#646974; font-weight:400; }
.timeline { margin-left:16rpx; border-left:2rpx solid #dac9a3; }
.round-record { padding:0 0 30rpx 34rpx; }
.round-record:last-child { padding-bottom:12rpx; }
.round-label { position:relative; font-size:var(--font-body, 28rpx); color:#596170; margin-bottom:16rpx; line-height:1.5; }
.timeline-dot { position:absolute; left:-46rpx; top:9rpx; width:20rpx; height:20rpx; border:3rpx solid #fcfaf4; border-radius:50%; background:#bea66d; }
.round-card { border:1rpx solid #e8e0cf; border-radius:16rpx; background:#fffdf7; padding:24rpx 20rpx; box-shadow:0 6rpx 20rpx rgba(90,69,30,.035); }
.winner-row { display:flex; align-items:flex-start; gap:18rpx; }
.winner-row + .winner-row { margin-top:22rpx; padding-top:22rpx; border-top:1rpx solid #e8e4d9; }
.winner-avatar { flex:none; }
.draw-icon { display:flex; align-items:center; justify-content:center; width:72rpx; height:82rpx; background:#eef2e6; border-radius:8rpx; font-size:var(--font-display, 48rpx); flex:none; }
.winner-body { flex:1; min-width:0; border-left:2rpx solid #e5e1d6; padding-left:16rpx; }
.winner-summary { display:flex; align-items:center; justify-content:space-between; gap:10rpx; flex-wrap:wrap; }
.winner-title { display:flex; align-items:center; gap:10rpx; flex-wrap:wrap; }
.winner-name { font-size:var(--font-body, 28rpx); font-weight:700; }
.type-tag,.round-yaku-tag { padding:4rpx 10rpx; border-radius:6rpx; background:#eaf0e2; font-size:var(--font-caption, 22rpx); font-weight:400; }
.win-points { font-size:var(--font-heading, 36rpx); font-weight:700; white-space:nowrap; }
.win-points text { font-size:var(--font-small, 24rpx); margin-left:5rpx; font-weight:400; }
.round-description { display:block; margin-top:8rpx; font-size:var(--font-small, 24rpx); line-height:1.5; color:#6c706e; overflow-wrap:anywhere; }
.round-yaku { display:flex; align-items:center; flex-wrap:wrap; gap:8rpx; margin-top:14rpx; font-size:var(--font-caption, 22rpx); line-height:1.5; }
.round-yaku-label,.round-yaku-empty { color:#777d72; }
.empty-records { display:block; text-align:center; padding:28rpx; color:#777d72; font-size:var(--font-small, 24rpx); }
.share-actions { flex-shrink:0; display:flex; gap:14rpx; border-top:1rpx solid #dfdfd4; padding:18rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); background:#fcfaf4; }
.share-button { display:flex; align-items:center; justify-content:center; gap:14rpx; width:0!important; min-width:0!important; flex:1; margin:0!important; font-size:var(--font-body, 28rpx); line-height:1.5; padding:22rpx 4rpx!important; border:1rpx solid #174e40; border-radius:12rpx; color:#103f33; background:#fffdf7; }
.share-button:active { opacity:.75; }
.share-actions .primary { color:#fffdf4; background:linear-gradient(110deg,#185344,#103f33); }
.copy-icon { position:relative; width:21rpx; height:25rpx; border:3rpx solid currentColor; border-radius:4rpx; margin-left:5rpx; }
.copy-icon::before { content:''; position:absolute; width:18rpx; height:22rpx; left:-9rpx; top:-9rpx; border:3rpx solid currentColor; border-radius:4rpx; border-right:0; border-bottom:0; }
.image-icon { width:29rpx; height:30rpx; border:3rpx solid currentColor; border-radius:4rpx; position:relative; overflow:hidden; }
.image-icon::before { content:''; width:6rpx; height:6rpx; position:absolute; top:5rpx; left:5rpx; border-radius:50%; background:currentColor; }
.image-icon view { width:22rpx; height:20rpx; border:3rpx solid currentColor; transform:rotate(40deg); position:absolute; top:17rpx; left:8rpx; }

.win-points .win-han-fu { font-size:var(--font-caption, 22rpx); color:#6c706e; font-weight:400; margin:0 10rpx 0 0; }
