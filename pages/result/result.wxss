.container {
  padding:0 24rpx calc(24rpx + env(safe-area-inset-bottom));
}

.result-context {
  background:#224e3e;
  color:#f8f5e6;
  text-align:center;
  font-size:var(--font-body, 28rpx);
  font-family:'Songti SC','STSong',serif;
  font-weight:600;
  margin:0 -24rpx;
  padding:24rpx 24rpx 70rpx;
  border-radius:0 0 30rpx 30rpx;
}

.result-hero {
  position:relative;
  background:#fdfcf7;
  border:1rpx solid #e5e4d8;
  border-radius:24rpx;
  text-align:center;
  margin-top:-45rpx;
  padding:28rpx 24rpx;
  box-shadow:0 5rpx 12rpx rgba(38,42,23,.04);
  display:flex;
  flex-direction:column;
}

.score-caption {
  font-size:var(--font-small, 24rpx);
  color:#6a7165;
  order:0;
}

.hero-badge {
  order:1;
  align-self:center;
  color:#9b6d24;
  background:#f4ebd3;
  font-size:var(--font-small, 24rpx);
  border-radius:9rpx;
  padding:4rpx 18rpx;
  margin:10rpx 0 0;
}

.result-points {
  order:2;
  display:block;
  color:#976013;
  font-family:'Songti SC','STSong',serif;
  font-size:var(--font-hero, 96rpx);
  font-weight:800;
  line-height:1.2;
  margin:10rpx 0;
}

.score-unit {
  font-family:-apple-system,sans-serif;
  font-size:var(--font-body, 28rpx);
  margin-left:12rpx;
}

.result-fuban {
  order:3;
  display:block;
  font-size:var(--font-body, 28rpx);
  font-weight:600;
}

.result-payment {
  order:4;
  display:block;
  margin-top:12rpx;
  font-size:var(--font-caption, 22rpx);
  color:#77816f;
}

.payment-grid {
  order:5;
  display:flex;
  margin-top:22rpx;
  padding-top:20rpx;
  border-top:1rpx solid #e5e6da;
}

.payment-cell {
  flex:1;
  border-right:1rpx solid #e3e4d8;
}

.payment-cell:last-child {
  border:0;
}

.payment-label {
  display:block;
  font-size:var(--font-small, 24rpx);
  color:#6a7664;
}

.payment-number {
  display:block;
  font-family:'Songti SC','STSong',serif;
  font-size:var(--font-display, 48rpx);
  color:#245240;
  font-weight:700;
}

.payment-unit {
  font-family:-apple-system,sans-serif;
  font-size:var(--font-caption, 22rpx);
  margin-left:8rpx;
}

.result-hand {
  margin-top:26rpx;
}

.hand-card {
  padding:8rpx 10rpx;
}

.hand-tiles-row,.meld-tiles-row {
  display:flex;
  gap:5rpx;
  flex-wrap:wrap;
  align-items:center;
}

.hand-sep {
  width:8rpx;
}

.melds-row {
  display:flex;
  gap:20rpx;
  flex-wrap:wrap;
  margin-top:18rpx;
}

.meld-group {
  text-align:center;
}

.meld-label {
  font-size:var(--font-caption, 22rpx);
  color:#7d826f;
}

.context-tags {
  display:flex;
  gap:8rpx;
  margin-top:18rpx;
}

.ctx-tag {
  font-size:var(--font-caption, 22rpx);
  color:#65745b;
  background:#e9ede0;
  border-radius:7rpx;
  padding:4rpx 14rpx;
}

.yaku-section {
  margin-top:26rpx;
}

.yaku-section-title {
  display:block;
  font-size:var(--font-body, 28rpx);
  margin-bottom:14rpx;
}

.yaku-card {
  border-radius:20rpx;
  overflow:hidden;
  background:#e9ede1;
}

.yaku-item {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12rpx;
  padding:20rpx 24rpx;
  border-bottom:1rpx solid #dbe1d0;
}

.yaku-item:last-child {
  border:0;
}

.yaku-cn {
  display:block;
  font-size:var(--font-label, 32rpx);
  font-weight:600;
}

.yaku-ja {
  display:block;
  font-size:var(--font-caption, 22rpx);
  color:#77826d;
  margin-top:3rpx;
}

.yaku-han {
  font-family:'Songti SC','STSong',serif;
  font-weight:700;
  font-size:var(--font-label, 32rpx);
  white-space:nowrap;
}

.yaku-han.yakuman {
  color:#a4731d;
}

.fu-section {
  margin-top:22rpx;
}

.fu-card {
  border:1rpx solid #e1e2d6;
  border-radius:20rpx;
  overflow:hidden;
  background:#fcfbf6;
}

.fu-header {
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:24rpx;
}

.fu-title {
  font-size:var(--font-body, 28rpx);
}

.fu-arrow {
  color:#808773;
  font-size:var(--font-small, 24rpx);
}

.fu-detail {
  border-top:1rpx solid #e4e4d8;
}

.fu-row {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16rpx;
  padding:16rpx 24rpx;
  font-size:var(--font-small, 24rpx);
}

.fu-row+.fu-row {
  border-top:1rpx solid #eeeee4;
}

.fu-val {
  white-space:nowrap;
  font-weight:600;
}

.fu-total {
  background:#f5ebd7;
  color:#976013;
}

.result-actions {
  display:flex;
  flex-direction:column;
  gap:14rpx;
  margin-top:26rpx;
}


.result-context { position:relative; overflow:hidden; }
.result-art { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; opacity:.4; }
.result-context-label { position:relative; z-index:1; }
.hand-card { display:flex; flex-wrap:wrap; gap:18rpx 20rpx; }
.hand-card .section-title { width:100%; margin-bottom:0; }
.hand-block { flex:1; min-width:0; }
.hand-group-label { display:block; font-size:var(--font-caption, 22rpx); color:#7b806f; margin-bottom:12rpx; }
.winning-block { flex-shrink:0; padding:10rpx 12rpx; background:#f4ecd8; border-radius:12rpx; }
.winning-block .hand-group-label { color:#9b6223; }
.melds-row { width:100%; margin-top:0; padding-top:16rpx; border-top:1rpx solid #e2e4d8; }
.context-tags { width:100%; margin-top:0; }
