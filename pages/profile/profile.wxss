.profile-page { padding:0 28rpx calc(140rpx + env(safe-area-inset-bottom)); }
.profile-heading { position:relative; height:240rpx; margin:0 -28rpx; padding:36rpx 28rpx 0; overflow:hidden; }
.profile-art { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; }
.profile-title { position:relative; color:#142f29; font-family:'Songti SC','STSong',serif; font-size:var(--font-display, 48rpx); font-weight:800; }
.profile-brand { display:flex; flex-direction:column; align-items:center; gap:16rpx; padding:0 0 48rpx; }
.profile-mark { display:flex; justify-content:center; align-items:center; width:124rpx; height:124rpx; border-radius:24rpx; background:#24483e; color:#fffdf4; font-family:'Songti SC','STSong',serif; font-size:var(--font-score, 64rpx); }
.profile-name { font-size:var(--font-heading, 36rpx); font-weight:600; }
.profile-note { font-size:var(--font-small, 24rpx); color:#697268; }
.profile-feedback { display:flex; justify-content:space-between; width:100%; margin:0; color:#24483e; font-size:var(--font-body, 28rpx); line-height:1.5; }
