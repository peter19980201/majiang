<image class="page-landscape page-landscape-tab" src="/assets/home/profile-landscape.jpg" mode="aspectFill" aria-hidden="true" />
<image class="page-motto-art" src="/assets/home/profile-motto.png" mode="aspectFit" aria-label="以牌会友，乐在其中" />
<view class="container profile-page">
  <view class="profile-heading">
    <view class="profile-user" aria-label="头像和昵称预留区">
      <view class="profile-avatar"><image class="profile-avatar-icon" src="/assets/navigation/profile-active.svg" mode="aspectFit" aria-hidden="true" /></view>
      <text class="profile-user-name">用户昵称</text>
    </view>
  </view>
  <button class="card profile-feedback" open-type="feedback">
    <image class="feedback-icon" src="/assets/navigation/feedback.svg" mode="aspectFit" aria-hidden="true" />
    <text class="feedback-label">意见反馈</text>
    <text class="feedback-arrow" aria-hidden="true">›</text>
  </button>
</view>
