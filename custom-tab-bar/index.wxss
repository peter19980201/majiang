:host { display:block; }
.tab-bar { position:fixed; z-index:100; left:0; right:0; bottom:0; display:flex; padding:10rpx 12rpx calc(10rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #dadccf; background:#f6f4ed; }
.tab-item { position:relative; z-index:1; overflow:visible; flex:1; min-width:0; margin:0; padding:8rpx 0; border-radius:0; background:transparent; color:#a8aca9; font-size:var(--font-caption, 22rpx); line-height:1.5; display:flex; flex-direction:column; align-items:center; gap:6rpx; }
.tab-item::after { border:0; }
.tab-item.selected { color:#205640; font-weight:600; }
.tab-item:active { opacity:.65; }
.tab-icon-slot { height:56rpx; display:flex; align-items:center; justify-content:center; }
.tab-icon { display:block; width:48rpx; height:48rpx; }
.tab-icon-add { width:72rpx; height:72rpx; }
/* The filled curve masks the straight border below it and joins the bar at both ends. */
.tab-bar-rise { position:absolute; width:180rpx; height:36rpx; left:50%; top:-34rpx; transform:translateX(-50%); pointer-events:none; }
.new-game { margin-top:-28rpx; padding-top:36rpx; }
.new-game .tab-icon-slot { transform:translateY(-18rpx); }

@import '/styles/confirmation.wxss';
@import "../styles/felt.wxss";


.mode-picker-mask { position:fixed; inset:0; z-index:1000; display:flex; align-items:flex-end; visibility:hidden; pointer-events:none; background:rgba(8,25,20,0); transition:background-color 220ms ease-out,visibility 0s 220ms; }
.mode-picker-mask.is-open { visibility:visible; pointer-events:auto; background:rgba(8,25,20,.5); transition:background-color 220ms ease-out,visibility 0s; }
.mode-picker-sheet { width:100%; box-sizing:border-box; padding:16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius:32rpx 32rpx 0 0; background:#faf8ef; color:#183e32; transform:translateY(100%); transition:transform 220ms cubic-bezier(.32,.72,0,1); }
.is-open .mode-picker-sheet { transform:translateY(0); }
.mode-picker-grip { width:72rpx; height:8rpx; margin:0 auto 18rpx; border-radius:8rpx; background:#d6d5cf; }
.mode-picker-heading { display:flex; align-items:center; justify-content:space-between; margin-bottom:24rpx; font-size:var(--font-heading, 36rpx); font-weight:600; }
.mode-picker-close { flex:0 0 54rpx; min-width:54rpx!important; max-width:54rpx; width:54rpx!important; height:54rpx; padding:0!important; margin:0 0 0 auto!important; line-height:50rpx; font-size:var(--font-title, 40rpx); font-weight:400; color:#344b47; background:#eeede5; border-radius:50%; }
.mode-picker-close::after,.mode-picker-option::after { border:0; }
.mode-picker-options { display:flex; gap:24rpx; }
.mode-picker-option { color:#fffdf6; flex:1; width:0!important; min-width:0; margin:0; padding:28rpx 12rpx; border-radius:18rpx; line-height:1.5; }
.mode-picker-name { display:block; font-size:var(--font-title, 40rpx); font-weight:600; }
.mode-picker-note { display:block; margin-top:6rpx; font-size:var(--font-small, 24rpx); opacity:.8; }
@media (prefers-reduced-motion:reduce) { .mode-picker-mask,.mode-picker-mask.is-open,.mode-picker-sheet { transition:none; } }
