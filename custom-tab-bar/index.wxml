<view class="tab-bar">
  <image class="tab-bar-rise" src="/assets/navigation/bar-rise.svg" mode="scaleToFill" aria-hidden="true" />
  <button wx:for="{{tabs}}" wx:key="icon" class="tab-item {{selected === item.route ? 'selected' : ''}} {{item.icon === 'add' ? 'new-game' : ''}}" bindtap="activate" data-index="{{index}}" aria-label="{{item.label}}" aria-current="{{selected === item.route ? 'page' : 'false'}}">
    <view class="tab-icon-slot" aria-hidden="true"><image class="tab-icon {{item.icon === 'add' ? 'tab-icon-add' : ''}}" src="{{item.icon === 'add' ? '/assets/navigation/add.svg' : '/assets/navigation/' + item.icon + (selected === item.route ? '-active.svg' : '-idle.svg')}}" mode="aspectFit" /></view>
    <text>{{item.label}}</text>
  </button>
</view>
<view class="new-game-mask {{newGameVisible ? 'motion-open' : ''}}" aria-hidden="{{!newGameVisible}}" catchtouchmove="blockModalTouch" catchtap="blockModalTouch">
  <view class="new-game-dialog" role="dialog" aria-modal="true" aria-label="结算当前对局并新建？">
    <image class="dialog-art" src="/assets/home/resume.jpg" mode="scaleToFill" aria-hidden="true" />
    <view class="dialog-content">
      <text class="dialog-title">结算当前对局并新建？</text>
      <text class="dialog-warning">当前对局将立即结束</text>
      <text class="dialog-description">按现有点数结算并保存到历史记录，
然后进入新对局设置。</text>
      <view class="dialog-actions">
        <button class="dialog-cancel" bindtap="cancelNewGame">取消</button>
        <button class="dialog-confirm btn-primary" bindtap="confirmNewGame">结算并新建</button>
      </view>
    </view>
  </view>
</view>

<view class="mode-picker-mask {{modePickerVisible ? 'is-open' : ''}}" aria-hidden="{{!modePickerVisible}}" catchtap="closeModePicker" catchtouchmove="blockModalTouch">
  <view class="mode-picker-sheet" role="dialog" aria-modal="true" aria-label="选择对局人数" catchtap="blockModalTouch">
    <drawer-handle bind:activate="closeModePicker" />
    <view class="mode-picker-heading"><text>新建对局</text><button class="mode-picker-close" bindtap="closeModePicker" aria-label="关闭人数选择">×</button></view>
    <view class="mode-picker-options">
      <button class="mode-picker-option btn-primary" data-count="3" bindtap="selectGameMode"><text class="mode-picker-name">三麻</text><text class="mode-picker-note">三人对局</text></button>
      <button class="mode-picker-option btn-primary" data-count="4" bindtap="selectGameMode"><text class="mode-picker-name">四麻</text><text class="mode-picker-note">四人对局</text></button>
    </view>
  </view>
</view>
