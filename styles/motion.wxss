/* Small, interruptible transitions shared by pages and embedded forms. */
.motion-collapse { display:grid; grid-template-rows:0fr; opacity:0; pointer-events:none; transition:grid-template-rows 200ms cubic-bezier(.23,1,.32,1),opacity 160ms ease-out; }
.motion-collapse.motion-open { grid-template-rows:1fr; opacity:1; pointer-events:auto; }
.motion-collapse-inner { min-height:0; overflow:hidden; }
.motion-chevron { display:inline-block; transform:rotate(0); transition:transform 200ms cubic-bezier(.23,1,.32,1); }
.motion-chevron.motion-open { transform:rotate(90deg); }
.motion-sheet-mask.modal-mask { visibility:hidden; pointer-events:none; background:rgba(0,0,0,0); transition:background-color 200ms ease-out,visibility 0s 200ms; }
.motion-sheet-mask.modal-mask .modal-content { transform:translateY(100%); transition:transform 220ms cubic-bezier(.32,.72,0,1); }
.motion-sheet-mask.modal-mask.motion-open { visibility:visible; pointer-events:auto; background:rgba(8,25,20,.5); transition:background-color 220ms ease-out; }
.motion-sheet-mask.modal-mask.motion-open .modal-content { transform:translateY(0); }
.motion-segments { position:relative; isolation:isolate; gap:0!important; padding:4rpx!important; }
.motion-segments > .motion-selection { position:absolute; left:4rpx; top:4rpx; bottom:4rpx; width:calc(50% - 4rpx); border-radius:10rpx; background:#1d5142; box-shadow:0 2rpx 5rpx rgba(0,30,20,.12); pointer-events:none; z-index:0; transition:transform 180ms cubic-bezier(.23,1,.32,1); }
.motion-segments > .seg,.motion-segments > .uma-btn { position:relative; z-index:1; flex:1; background:transparent!important; border-color:transparent; transition:color 180ms ease-out; }
.motion-segments > .seg.active,.motion-segments > .uma-btn.active { background:transparent!important; background-image:none!important; color:#fffbea; }
@media (prefers-reduced-motion:reduce) {
 .motion-collapse,.motion-chevron,.motion-sheet-mask.modal-mask,.motion-sheet-mask.modal-mask.motion-open,.motion-sheet-mask.modal-mask .modal-content,.motion-segments > .motion-selection,.motion-segments > .seg,.motion-segments > .uma-btn { transition:none; }
}
