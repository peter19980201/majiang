/* Reuse the board cloth. Data URI supports WXSS backgrounds without network requests.
 * Keep this material below disabled-state overrides and out of decorative artwork.
 */
.btn-primary,
.modal-btn.confirm,
.seg.active,
.rules-tabs .seg.active,
.table-row.table-head,
.save,
.result-context,
.tab.active,
.suit-tab.active,
.chip.on,
.hand-table,
.first,
.share-actions .primary,
.payment-card,
.uma-btn.active,
.edit-button,
.current-badge,
.current-btn.resume,
.ron-card-save,
.psel.active,
.riichi-toggle-check.on,
.compass,
.board-action:last-child,
.win-choice.selected,
.win-radio.checked,
.win-confirm,
.win-save,
.profile-mark,
.resume-badge,
.cat-tag.active,
.switch-track.active {
  background-color:#204e40;
  background-image:linear-gradient(rgba(12,40,30,.20),rgba(12,40,30,.20)),url("data:image/jpeg;base64,");
  background-size:cover;
  background-position:center;
  background-repeat:no-repeat;
}
.confirm-button.confirm-disabled,.win-choice.is-disabled,.win-confirm.is-incomplete,.psel.disabled,.edit-button[disabled] {
  background-image:none;
}
