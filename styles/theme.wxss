/* Pine, ivory and brass — shared native mini-program components. */
.card,.section {
  background:#fdfcf8;
  border:1rpx solid #e8e5dc;
  border-radius:24rpx;
  padding:24rpx;
  margin-bottom:18rpx;
}

.section-title {
  display:block;
  font-size:var(--font-label, 32rpx);
  font-weight:600;
  margin-bottom:18rpx;
  color:#182f2b;
}

.section-header {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12rpx;
  margin-bottom:16rpx;
}

.section-header .section-title {
  margin:0;
}

.section-note {
  font-size:var(--font-caption, 22rpx);
  color:#737b74;
}

.btn-primary,.btn-secondary,.modal-btn {
  display:flex;
  align-items:center;
  justify-content:center;
  min-height:88rpx;
  padding:18rpx 24rpx;
  border-radius:18rpx;
  font-size:var(--font-label, 32rpx);
  font-weight:600;
  text-align:center;
}

.btn-primary,.modal-btn.confirm {
  background:linear-gradient(120deg,#204e40,#123c31);
  color:#fffdf6;
  border:1rpx solid #204e40;
}

.btn-secondary,.modal-btn.cancel {
  background:#faf9f4;
  border:1rpx solid #c4c9c0;
  color:#24483e;
}

.btn-primary:active,.btn-secondary:active,.modal-btn:active {
  opacity:.78;
}

.seg-ctrl {
  display:flex;
  background:#eeeee7;
  border-radius:14rpx;
  padding:4rpx;
  gap:6rpx;
}

.seg {
  flex:1;
  min-width:0;
  min-height:64rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:10rpx 4rpx;
  font-size:var(--font-body, 28rpx);
  border-radius:11rpx;
  color:#5c6861;
}

.seg.active {
  background:#204e40;
  color:#fffdf6;
}

.stepper {
  display:flex;
  align-items:center;
  gap:10rpx;
}

.step-btn {
  width:64rpx;
  height:64rpx;
  line-height:60rpx;
  border:1rpx solid #ddded4;
  border-radius:14rpx;
  text-align:center;
  font-size:var(--font-heading, 36rpx);
  color:#24483e;
  background:#faf9f4;
}

.step-btn:active {
  background:#e4e9df;
}

.step-val {
  text-align:center;
  font-size:var(--font-label, 32rpx);
  font-weight:600;
  font-variant-numeric:tabular-nums;
  border-radius:12rpx;
  padding:8rpx 20rpx;
  background:#eeefe8;
}

.modal-mask {
  position:fixed;
  top:0;
  left:0;
  right:0;
  bottom:0;
  background:rgba(8,25,20,.58);
  z-index:200;
  display:flex;
  align-items:flex-end;
  justify-content:center;
}

.modal-content {
  width:100%;
  max-height:88vh;
  overflow-y:auto;
  background:#f9f7f0;
  color:#182f2b;
  border-radius:36rpx 36rpx 0 0;
  padding:16rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
}

.modal-handle {
  width:62rpx;
  height:7rpx;
  background:#c6c7bd;
  border-radius:8rpx;
  margin:0 auto 22rpx;
}

.modal-title {
  display:block;
  font-size:var(--font-heading, 36rpx);
  font-weight:700;
  text-align:center;
  margin-bottom:24rpx;
}

.modal-subtitle {
  display:block;
  font-size:var(--font-small, 24rpx);
  color:#69776e;
  text-align:center;
  margin-bottom:24rpx;
}

.modal-actions {
  display:flex;
  gap:16rpx;
  margin-top:28rpx;
}

.modal-actions .modal-btn {
  flex:1;
  min-width:0;
}

.positive {
  color:#235a46;
}

.negative {
  color:#af443a;
}

.empty {
  text-align:center;
  padding:80rpx 24rpx;
  color:#738077;
}

.empty-symbol {
  display:block;
  font-family:'Songti SC','STSong',serif;
  font-size:var(--font-score, 64rpx);
  color:#9aa897;
  margin-bottom:20rpx;
}

.empty-text {
  display:block;
  font-size:var(--font-body, 28rpx);
}

.empty-hint {
  display:block;
  font-size:var(--font-small, 24rpx);
  margin-top:12rpx;
  color:#7d857e;
}

.local-note {
  text-align:center;
  color:#7b817a;
  font-size:var(--font-caption, 22rpx);
  padding:28rpx 0 4rpx;
}


/* Shared ivory surfaces and pine controls, coordinated with illustrated home. */
.card,.section { box-shadow:0 3rpx 12rpx rgba(48,47,25,.035); }
.btn-primary,.modal-btn.confirm { box-shadow:inset 0 1rpx 0 rgba(255,255,255,.15),0 3rpx 6rpx rgba(15,48,34,.08); }
.modal-content { background:linear-gradient(135deg,#fdfbf5,#f6f3e9); box-shadow:0 -8rpx 36rpx rgba(7,30,22,.13); }

@import '/styles/felt.wxss';
